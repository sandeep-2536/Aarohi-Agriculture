<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aarohi AI Assistant - Smart Farming</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">

    <style>
        * { box-sizing: border-box; }

        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Montserrat', sans-serif;
            background-color: #020d08;
            overflow: hidden;
        }

        /* ── Background ── */
        .ambient-canvas {
            position: fixed;
            inset: 0;
            z-index: 0;
            background:
                linear-gradient(to bottom, rgba(2,13,8,0.95), rgba(5,25,15,0.9)),
                url('home_bg.jpg') center/cover no-repeat;
        }

        /* ── Layout shell ── */
        .chat-wrapper {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            height: 100dvh;          /* dynamic viewport – handles mobile bars */
            overflow: hidden;
        }

        /* ── Message list ── */
        #chatMessages {
            flex: 1 1 0;
            overflow-y: auto;
            padding: clamp(0.75rem, 3vw, 2rem);
            display: flex;
            flex-direction: column;
            gap: clamp(1rem, 3vw, 2.5rem);
            scroll-behavior: smooth;
        }

        /* ── AI bubble ── */
        .ai-bubble {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 2rem;
            border-bottom-left-radius: 0.4rem;
            max-width: min(75%, 680px);
            padding: clamp(1rem, 3vw, 2rem);
            box-shadow: 0 20px 50px rgba(0,0,0,0.4);
            animation: slideInLeft 0.45s ease-out both;
        }

        /* ── User bubble ── */
        .user-bubble {
            background: linear-gradient(135deg, #10b981 0%, #065f46 100%);
            border-radius: 2rem;
            border-bottom-right-radius: 0.4rem;
            max-width: min(75%, 680px);
            align-self: flex-end;
            padding: clamp(0.75rem, 2.5vw, 2rem);
            color: #fff;
            box-shadow: 0 15px 35px rgba(16,185,129,0.2);
            animation: slideInRight 0.45s ease-out both;
            font-size: clamp(0.9rem, 2.2vw, 1.5rem);
            font-weight: 800;
        }

        @keyframes slideInLeft  { from { opacity:0; transform:translateX(-30px); } to { opacity:1; transform:none; } }
        @keyframes slideInRight { from { opacity:0; transform:translateX( 30px); } to { opacity:1; transform:none; } }

        /* ── Typing dots ── */
        .dot { width:10px; height:10px; border-radius:50%; background:#4ade80; animation:bounce 0.8s infinite; }
        .dot:nth-child(2) { animation-delay:.1s; }
        .dot:nth-child(3) { animation-delay:.2s; }
        @keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }

        /* ── Input area ── */
        .input-hub {
            flex-shrink: 0;
            background: rgba(5,25,15,0.92);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: clamp(0.75rem, 2.5vw, 1.5rem) clamp(0.75rem, 3vw, 2rem);
        }

        .custom-input {
            background: rgba(255,255,255,0.05);
            border: 2px solid rgba(255,255,255,0.1);
            border-radius: 1.75rem;
            width: 100%;
            color: #fff;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            outline: none;
            transition: border-color 0.3s, background 0.3s, box-shadow 0.3s;
            font-size: clamp(0.9rem, 2vw, 1.35rem);
            padding: clamp(0.75rem, 2vw, 1.25rem) clamp(3.5rem, 8vw, 5rem) clamp(0.75rem, 2vw, 1.25rem) clamp(1rem, 3vw, 1.75rem);
        }
        .custom-input::placeholder { color: rgba(255,255,255,0.2); }
        .custom-input:focus {
            background: rgba(255,255,255,0.09);
            border-color: #4ade80;
            box-shadow: 0 0 20px rgba(74,222,128,0.18);
        }

        .send-btn {
            background: #10b981;
            color: #020d08;
            border-radius: 1.5rem;
            font-family: 'Montserrat', sans-serif;
            font-weight: 900;
            letter-spacing: .12em;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            white-space: nowrap;
            padding: clamp(0.75rem, 2vw, 1.25rem) clamp(1.25rem, 4vw, 3rem);
            font-size: clamp(0.75rem, 1.5vw, 1rem);
        }
        .send-btn:hover  { background: #4ade80; }
        .send-btn:active { transform: scale(0.95); }

        /* ── Scrollbar ── */
        #chatMessages::-webkit-scrollbar { width: 4px; }
        #chatMessages::-webkit-scrollbar-thumb { background: #4ade80; border-radius: 10px; }

        /* ── Suggestion cards ── */
        .suggestion-card {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 1rem;
            padding: clamp(0.75rem, 2vw, 1.25rem);
            font-size: clamp(0.7rem, 1.4vw, 0.85rem);
            font-weight: 800;
            text-align: left;
            text-transform: uppercase;
            letter-spacing: -.03em;
            color: #fff;
            cursor: pointer;
            transition: background 0.2s, color 0.2s, transform 0.15s;
        }
        .suggestion-card:hover { background: #10b981; color: #020d08; transform: translateY(-2px); }

        /* ── Nav ── */
        .nav-pill {
            font-size: clamp(0.6rem, 1.2vw, 0.7rem);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .25em;
            color: #fff;
            text-decoration: none;
            transition: color 0.2s;
        }
        .nav-pill:hover { color: #4ade80; }

        /* ── Header action buttons ── */
        .hdr-btn {
            font-size: clamp(0.6rem, 1.2vw, 0.7rem);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .1em;
            border-radius: 0.75rem;
            border: 1px solid;
            cursor: pointer;
            transition: background 0.2s, color 0.2s;
            padding: clamp(0.35rem, 1vw, 0.5rem) clamp(0.65rem, 1.5vw, 1.25rem);
        }

        /* ── Mic icon ── */
        .mic-btn {
            position: absolute;
            right: clamp(0.75rem, 2vw, 2rem);
            top: 50%;
            transform: translateY(-50%);
            color: #4ade80;
            background: none;
            border: none;
            cursor: pointer;
            transition: color 0.2s;
            display: flex;
            align-items: center;
        }
        .mic-btn:hover { color: #ef4444; }
        .mic-btn svg { width: clamp(1.5rem, 4vw, 2.5rem); height: clamp(1.5rem, 4vw, 2.5rem); }

        /* ── Welcome text ── */
        #welcomeText {
            font-size: clamp(1.1rem, 3.5vw, 1.9rem);
            font-weight: 700;
            line-height: 1.4;
            color: #fff;
            margin-bottom: clamp(1rem, 3vw, 2rem);
        }

        /* ── AI reply text ── */
        .ai-reply-text {
            font-size: clamp(0.9rem, 2.2vw, 1.5rem);
            font-weight: 700;
            line-height: 1.65;
            color: #fff;
        }

        /* ── Read btn ── */
        .read-btn {
            margin-top: 0.75rem;
            color: #6ee7b7;
            background: none;
            border: none;
            cursor: pointer;
            font-size: clamp(0.7rem, 1.4vw, 0.85rem);
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
        }
        .read-btn:hover { color: #4ade80; }

        /* ── Mobile hamburger (≤md) ── */
        #mobileMenu { display: none; }
        @media (max-width: 767px) {
            #mobileMenu.open { display: flex; }
        }
    </style>
</head>
<body>

<div class="ambient-canvas"></div>

<div class="chat-wrapper">

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <header class="flex items-center justify-between px-4 sm:px-8 py-3 sm:py-5 bg-transparent border-b border-white/5 backdrop-blur-md flex-shrink-0">

        <!-- Logo -->
        <div class="flex items-center gap-3">
            <div class="bg-white p-1.5 sm:p-2 rounded-xl shadow-lg">
                <img src="/aarohi_logo.png" class="w-8 h-8 sm:w-10 sm:h-10 object-contain" alt="Aarohi Logo">
            </div>
            <div>
                <h2 class="text-white font-black tracking-tighter leading-none uppercase text-lg sm:text-2xl">Aarohi AI</h2>
                <p class="text-green-400 font-bold uppercase tracking-[.3em] mt-0.5" style="font-size:clamp(0.45rem,1vw,0.6rem)">Expert Farmer Console</p>
            </div>
        </div>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-6 lg:gap-8 px-6 lg:px-8 py-2.5 bg-white/5 rounded-full border border-white/10">
            <a href="/"          class="nav-pill">Home</a>
            <a href="/schemes"   class="nav-pill">Govt Money</a>
            <a href="/market"    class="nav-pill">Marketplace</a>
            <a href="/community" class="nav-pill">Community</a>
        </nav>

        <!-- Header actions -->
        <div class="flex items-center gap-2 sm:gap-3">
            <button id="autoReadBtn" onclick="toggleAutoRead()"
                class="hdr-btn bg-blue-500/10 text-blue-400 border-blue-500/20 hover:bg-blue-500 hover:text-white hidden sm:block">
                🔊 Auto‑read Off
            </button>
            <button onclick="location.reload()"
                class="hdr-btn bg-red-500/10 text-red-400 border-red-500/20 hover:bg-red-500 hover:text-white hidden sm:block">
                Clear Chat
            </button>

            <!-- Mobile hamburger -->
            <button class="md:hidden text-white p-2" onclick="toggleMobileMenu()" aria-label="Menu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        </div>
    </header>

    <!-- Mobile drawer -->
    <div id="mobileMenu" class="flex-col gap-3 px-4 py-4 bg-black/60 backdrop-blur border-b border-white/10 md:hidden">
        <a href="/"          class="nav-pill block">Home</a>
        <a href="/schemes"   class="nav-pill block">Govt Money</a>
        <a href="/market"    class="nav-pill block">Marketplace</a>
        <a href="/community" class="nav-pill block">Community</a>
        <div class="flex gap-3 pt-1">
            <button id="autoReadBtnMobile" onclick="toggleAutoRead()"
                class="hdr-btn bg-blue-500/10 text-blue-400 border-blue-500/20 hover:bg-blue-500 hover:text-white">
                🔊 Auto‑read Off
            </button>
            <button onclick="location.reload()"
                class="hdr-btn bg-red-500/10 text-red-400 border-red-500/20 hover:bg-red-500 hover:text-white">
                Clear Chat
            </button>
        </div>
    </div>

    <!-- ═══════════════════ MESSAGES ═══════════════════ -->
    <div id="chatMessages">

        <!-- Welcome bubble -->
        <div class="ai-bubble">
            <div class="flex items-center gap-2 mb-4 sm:mb-6">
                <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-green-500 rounded-full animate-pulse shadow-[0_0_15px_#10b981]"></span>
                <p class="font-black text-green-400 uppercase tracking-widest" style="font-size:clamp(0.5rem,1.2vw,0.65rem)">Aarohi Project Intelligence</p>
            </div>

            <div id="welcomeText">
                Namaste! 🙏 I am your expert guide. <br>
                I have been trained on the <span class="text-green-400 underline decoration-wavy underline-offset-8">Aarohi Project</span> to help you with every farming challenge.
            </div>

            <button class="read-btn" onclick="speakText(document.getElementById('welcomeText').innerText, defaultLang)">🔊 Read</button>

            <!-- Suggestion cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4 sm:mt-6">
                <button class="suggestion-card" onclick="askQuestion('How to sell my crops on Aarohi?')">💰 Sell Harvest</button>
                <button class="suggestion-card" onclick="askQuestion('Show me schemes for small farmers')">🚜 Govt Schemes</button>
                <button class="suggestion-card" onclick="askQuestion('How to call a Vet doctor?')">🏥 Animal Help</button>
            </div>
        </div>

    </div><!-- /#chatMessages -->

    <!-- ═══════════════════ INPUT HUB ═══════════════════ -->
    <div class="input-hub">
        <div class="max-w-5xl mx-auto flex gap-3">
            <div class="relative flex-grow">
                <input
                    type="text"
                    id="userInput"
                    placeholder="Write your farming question here..."
                    class="custom-input"
                    onkeypress="if(event.key==='Enter') sendMessage()"
                >
                <button onclick="startVoiceInput()" class="mic-btn" aria-label="Voice input">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7 4a3 3 0 016 0v4a3 3 0 11-6 0V4zm4 10.93A7.001 7.001 0 0017 8a1 1 0 10-2 0A5 5 0 015 8a1 1 0 00-2 0 7.001 7.001 0 006 6.93V17H6a1 1 0 100 2h8a1 1 0 100-2h-3v-2.07z" clip-rule="evenodd"/>
                    </svg>
                </button>
            </div>
            <button onclick="sendMessage()" class="send-btn">Send</button>
        </div>
    </div>

</div><!-- /.chat-wrapper -->

<!-- Voice helpers -->
<script src="/js/voiceOver.js"></script>
<script>
    const defaultLang = '<%= lang %>';

    /* ── Mobile menu toggle ── */
    function toggleMobileMenu() {
        const menu = document.getElementById('mobileMenu');
        menu.classList.toggle('open');
    }

    /* ── Send message ── */
    async function sendMessage() {
        const input = document.getElementById('userInput');
        const message = input.value.trim();
        if (!message) return;

        addMessage(message, 'user');
        input.value = '';
        showTyping();

        try {
            const res = await fetch('/ai/analyze', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ message })
            });
            const data = await res.json();
            removeTyping();
            addMessage(data.reply, 'ai', data.lang || defaultLang);
        } catch (e) {
            removeTyping();
            addMessage("I'm sorry, I'm having trouble reaching the Aarohi servers. 🌾", 'ai', defaultLang);
        }
    }

    /* ── Auto-read toggle ── */
    let autoRead = false;
    function toggleAutoRead() {
        autoRead = !autoRead;
        const label = autoRead ? '🔊 Auto‑read On' : '🔊 Auto‑read Off';
        const activeClass  = 'bg-green-500/10 text-green-400 border-green-500/20 hover:bg-green-500 hover:text-white';
        const inactiveClass= 'bg-blue-500/10 text-blue-400 border-blue-500/20 hover:bg-blue-500 hover:text-white';
        ['autoReadBtn','autoReadBtnMobile'].forEach(id => {
            const btn = document.getElementById(id);
            if (!btn) return;
            btn.textContent = label;
            btn.className = 'hdr-btn ' + (autoRead ? activeClass : inactiveClass);
        });
    }

    /* ── Add message bubble ── */
    function addMessage(text, type, lang = defaultLang) {
        const chat = document.getElementById('chatMessages');
        const div  = document.createElement('div');

        if (type === 'user') {
            div.className  = 'user-bubble';
            div.innerHTML  = text;
        } else {
            div.className  = 'ai-bubble';
            const formatted = text.replace(/(\/[a-z]+)/g, '<a href="$1" class="text-green-400 underline font-black">$1</a>');
            div.innerHTML = `
                <div class="flex items-center gap-2 mb-3 opacity-50">
                    <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                    <p class="font-black text-green-400 uppercase tracking-widest" style="font-size:clamp(0.5rem,1.2vw,0.62rem)">Expert Reply</p>
                </div>
                <div class="ai-reply-text">${formatted}</div>
            `;
            const btn = document.createElement('button');
            btn.className = 'read-btn';
            btn.textContent = '🔊 Read';
            btn.onclick = () => speakText(text, lang);
            div.appendChild(btn);

            if (autoRead) speakText(text, lang);
        }

        chat.appendChild(div);
        chat.scrollTo({ top: chat.scrollHeight, behavior: 'smooth' });
    }

    /* ── Typing indicator ── */
    function showTyping() {
        const chat = document.getElementById('chatMessages');
        const div  = document.createElement('div');
        div.id = 'typingIndicator';
        div.className = 'ai-bubble w-fit py-4 px-8';
        div.innerHTML = `<div class="flex gap-2"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>`;
        chat.appendChild(div);
        chat.scrollTop = chat.scrollHeight;
    }
    function removeTyping() { const el = document.getElementById('typingIndicator'); if (el) el.remove(); }

    /* ── Shortcut ── */
    function askQuestion(q) { document.getElementById('userInput').value = q; sendMessage(); }
    function startVoiceInput() { alert("Listening... Speak your problem clearly."); }

    /* ── Speak ── */
    function speakText(text, lang) {
        if (lang && window.voiceSetLang) voiceSetLang(lang);
        const clean = text.replace(/<[^>]+>/g, '').replace(/\n+/g, ' ');
        if (window.voiceSpeak) voiceSpeak(clean);
    }
</script>
</body>
</html>
