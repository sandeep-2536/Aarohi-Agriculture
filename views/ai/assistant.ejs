<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aarohi AI Assistant - Smart Farming</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Montserrat', sans-serif;
            background-color: #020d08;
            overflow: hidden;
        }

        /* 1. Full Page Background Canvas */
        .ambient-canvas {
            position: fixed;
            inset: 0;
            z-index: 0;
            background: linear-gradient(to bottom, rgba(2, 13, 8, 0.95), rgba(5, 25, 15, 0.9)), url('home_bg.jpg');
            background-size: cover;
            background-position: center;
        }

        /* 2. Chat Layout - 100% Space */
        .chat-wrapper {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        #chatMessages {
            flex: 1;
            overflow-y: auto;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
            scroll-behavior: smooth;
        }

        /* 3. Message Bubbles - High Contrast & Breathable */
        .ai-bubble {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 2.5rem;
            border-bottom-left-radius: 0.5rem;
            max-width: 75%;
            padding: 2rem;
            box-shadow: 0 20px 50px rgba(0,0,0,0.4);
            animation: slideInLeft 0.5s ease-out;
        }

        .user-bubble {
            background: linear-gradient(135deg, #10b981 0%, #065f46 100%);
            border-radius: 2.5rem;
            border-bottom-right-radius: 0.5rem;
            max-width: 75%;
            align-self: flex-end;
            padding: 2rem;
            color: white;
            box-shadow: 0 15px 35px rgba(16, 185, 129, 0.2);
            animation: slideInRight 0.5s ease-out;
        }

        @keyframes slideInLeft { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes slideInRight { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }

        /* 4. Input Hub - Full Width Dashboard Style */
        .input-hub {
            background: rgba(5, 25, 15, 0.9);
            backdrop-filter: blur(30px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding: 2rem;
        }

        .custom-input {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 2rem;
            transition: all 0.3s;
        }
        .custom-input:focus {
            background: rgba(255, 255, 255, 0.1);
            border-color: #4ade80;
            box-shadow: 0 0 20px rgba(74, 222, 128, 0.2);
        }

        /* Custom Scrollbar */
        #chatMessages::-webkit-scrollbar { width: 4px; }
        #chatMessages::-webkit-scrollbar-thumb { background: #4ade80; border-radius: 10px; }
    </style>
</head>
<body>

    <div class="ambient-canvas"></div>

    <div class="chat-wrapper">
        
        <header class="flex items-center justify-between px-10 py-6 bg-transparent border-b border-white/5 backdrop-blur-md">
            <div class="flex items-center gap-5">
                <div class="bg-white p-2 rounded-2xl shadow-lg">
                    <img src="/aarohi_logo.png" class="w-10 h-10 object-contain" alt="Aarohi Logo">
                </div>
                <div>
                    <h2 class="text-white text-2xl font-black tracking-tighter leading-none uppercase">Aarohi AI</h2>
                    <p class="text-[10px] text-green-400 font-bold uppercase tracking-[0.4em] mt-1">Expert Farmer Console</p>
                </div>
            </div>

            <nav class="hidden md:flex items-center gap-8 px-8 py-3 bg-white/5 rounded-full border border-white/10">
                <a href="/" class="text-xs font-black text-white hover:text-green-400 tracking-widest uppercase transition">Home</a>
                <a href="/schemes" class="text-xs font-black text-white hover:text-green-400 tracking-widest uppercase transition">Govt Money</a>
                <a href="/market" class="text-xs font-black text-white hover:text-green-400 tracking-widest uppercase transition">Marketplace</a>
                <a href="/community" class="text-xs font-black text-white hover:text-green-400 tracking-widest uppercase transition">Community</a>
            </nav>

            <div class="flex gap-4">
                <button onclick="location.reload()" class="bg-red-500/10 text-red-400 border border-red-500/20 px-5 py-2 rounded-xl text-xs font-black uppercase hover:bg-red-500 hover:text-white transition">Clear Chat</button>
            </div>
        </header>

        <div id="chatMessages">
            <div class="ai-bubble">
                <div class="flex items-center gap-3 mb-6">
                    <span class="w-3 h-3 bg-green-500 rounded-full animate-pulse shadow-[0_0_15px_#10b981]"></span>
                    <p class="text-[10px] font-black text-green-400 uppercase tracking-widest">Aarohi Project Intelligence</p>
                </div>
                <div class="text-white text-2xl md:text-3xl font-bold leading-tight mb-8">
                    Namaste! 🙏 I am your expert guide. <br>
                    I have been trained on the <span class="text-green-400 underline decoration-wavy underline-offset-8">Aarohi Project</span> to help you with every farming challenge.
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                    <button onclick="askQuestion('How to sell my crops on Aarohi?')" class="bg-white/5 hover:bg-green-500 hover:text-black border border-white/10 p-5 rounded-2xl text-sm font-black text-left uppercase tracking-tighter transition-all">💰 Sell Harvest</button>
                    <button onclick="askQuestion('Show me schemes for small farmers')" class="bg-white/5 hover:bg-green-500 hover:text-black border border-white/10 p-5 rounded-2xl text-sm font-black text-left uppercase tracking-tighter transition-all">🚜 Govt Schemes</button>
                    <button onclick="askQuestion('How to call a Vet doctor?')" class="bg-white/5 hover:bg-green-500 hover:text-black border border-white/10 p-5 rounded-2xl text-sm font-black text-left uppercase tracking-tighter transition-all">🏥 Animal Help</button>
                </div>
            </div>
        </div>

        <div class="input-hub">
            <div class="max-w-7xl mx-auto flex gap-4">
                <div class="relative flex-grow">
                    <input 
                        type="text" 
                        id="userInput" 
                        placeholder="Write your farming question here..."
                        class="custom-input w-full px-10 py-7 text-2xl text-white font-bold placeholder-gray-600 outline-none"
                        onkeypress="if(event.key==='Enter') sendMessage()"
                    >
                    <button onclick="startVoiceInput()" class="absolute right-8 top-1/2 -translate-y-1/2 text-green-400 hover:text-red-500 transition-colors">
                        <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7 4a3 3 0 016 0v4a3 3 0 11-6 0V4zm4 10.93A7.001 7.001 0 0017 8a1 1 0 10-2 0A5 5 0 015 8a1 1 0 00-2 0 7.001 7.001 0 006 6.93V17H6a1 1 0 100 2h8a1 1 0 100-2h-3v-2.07z" clip-rule="evenodd"></path></svg>
                    </button>
                </div>
                <button onclick="sendMessage()" class="bg-green-500 text-farm-deep px-14 py-7 rounded-3xl font-black text-xl uppercase tracking-widest shadow-2xl hover:bg-green-400 transition-all active:scale-95">
                    SEND
                </button>
            </div>
        </div>
    </div>

    <script>
        // Existing Back-end functionality
        async function sendMessage() {
            const input = document.getElementById('userInput');
            const message = input.value.trim();
            if (!message) return;

            addMessage(message, 'user');
            input.value = '';
            showTyping();

            try {
                const res = await fetch('/ai/analyze', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                const data = await res.json();
                removeTyping();
                addMessage(data.reply, 'ai');
            } catch (e) {
                removeTyping();
                addMessage("I'm sorry, I'm having trouble reaching the Aarohi servers. 🌾", 'ai');
            }
        }

        function addMessage(text, type) {
            const chat = document.getElementById('chatMessages');
            const div = document.createElement('div');
            
            if(type === 'user') {
                div.className = "user-bubble text-2xl font-black";
                div.innerHTML = text;
            } else {
                div.className = "ai-bubble";
                const formatted = text.replace(/(\/[a-z]+)/g, '<a href="$1" class="text-green-400 underline font-black">$1</a>');
                div.innerHTML = `
                    <div class="flex items-center gap-3 mb-4 opacity-50">
                        <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                        <p class="text-[10px] font-black text-green-400 uppercase tracking-widest">Expert Reply</p>
                    </div>
                    <div class="text-white text-2xl font-bold leading-relaxed">${formatted}</div>
                `;
            }
            chat.appendChild(div);
            chat.scrollTo({ top: chat.scrollHeight, behavior: 'smooth' });
        }

        function showTyping() {
            const chat = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.id = 'typingIndicator';
            div.className = "ai-bubble w-fit py-6 px-10";
            div.innerHTML = `<div class="flex gap-2"><div class="w-3 h-3 bg-green-400 rounded-full animate-bounce"></div><div class="w-3 h-3 bg-green-400 rounded-full animate-bounce" style="animation-delay:0.1s"></div><div class="w-3 h-3 bg-green-400 rounded-full animate-bounce" style="animation-delay:0.2s"></div></div>`;
            chat.appendChild(div);
            chat.scrollTop = chat.scrollHeight;
        }

        function removeTyping() { const el = document.getElementById('typingIndicator'); if (el) el.remove(); }
        function askQuestion(q) { document.getElementById('userInput').value = q; sendMessage(); }
        function startVoiceInput() { alert("Listening... Speak your problem clearly."); }
    </script>
</body>
</html>