<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aarohi AI Assistant - Smart Farming</title>

<script src="https://cdn.tailwindcss.com"></script>

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">

<style>

body, html {
height: 100%;
margin: 0;
font-family: 'Montserrat', sans-serif;
background-color: #020d08;
overflow: hidden;
}

/* Background */
.ambient-canvas {
position: fixed;
inset: 0;
z-index: 0;
background: linear-gradient(to bottom, rgba(2,13,8,0.95), rgba(5,25,15,0.9)), url('home_bg.jpg');
background-size: cover;
background-position: center;
}

/* Chat layout */
.chat-wrapper {
position: relative;
z-index: 10;
display: flex;
flex-direction: column;
height: 100vh;
}

#chatMessages {
flex: 1;
overflow-y: auto;
padding: 1rem;
display: flex;
flex-direction: column;
gap: 1.8rem;
scroll-behavior: smooth;
}

/* AI bubble */
.ai-bubble {
background: rgba(255,255,255,0.05);
backdrop-filter: blur(20px);
border: 1px solid rgba(255,255,255,0.1);
border-radius: 2rem;
border-bottom-left-radius: .5rem;
max-width: 85%;
padding: 1.5rem;
box-shadow: 0 20px 50px rgba(0,0,0,0.4);
animation: slideInLeft .5s ease-out;
}

/* User bubble */
.user-bubble {
background: linear-gradient(135deg,#10b981 0%,#065f46 100%);
border-radius: 2rem;
border-bottom-right-radius: .5rem;
max-width: 85%;
align-self: flex-end;
padding: 1.5rem;
color:white;
box-shadow: 0 15px 35px rgba(16,185,129,0.2);
animation: slideInRight .5s ease-out;
}

@keyframes slideInLeft {
from{opacity:0;transform:translateX(-40px)}
to{opacity:1;transform:translateX(0)}
}

@keyframes slideInRight {
from{opacity:0;transform:translateX(40px)}
to{opacity:1;transform:translateX(0)}
}

/* Input hub */
.input-hub {
background: rgba(5,25,15,0.9);
backdrop-filter: blur(25px);
border-top: 1px solid rgba(255,255,255,0.1);
padding: 1rem;
}

.custom-input {
background: rgba(255,255,255,0.05);
border: 2px solid rgba(255,255,255,0.1);
border-radius: 2rem;
transition: all .3s;
}

.custom-input:focus {
background: rgba(255,255,255,0.1);
border-color:#4ade80;
box-shadow:0 0 20px rgba(74,222,128,.2);
}

/* Scrollbar */
#chatMessages::-webkit-scrollbar {width:4px}
#chatMessages::-webkit-scrollbar-thumb {background:#4ade80;border-radius:10px}

</style>
</head>

<body>

<div class="ambient-canvas"></div>

<div class="chat-wrapper">

<header class="flex items-center justify-between px-4 sm:px-6 md:px-10 py-4 sm:py-6 bg-transparent border-b border-white/5 backdrop-blur-md">

<div class="flex items-center gap-3 sm:gap-5">

<div class="bg-white p-2 rounded-xl shadow-lg">
<img src="/aarohi_logo.png" class="w-8 h-8 sm:w-10 sm:h-10 object-contain">
</div>

<div>
<h2 class="text-white text-lg sm:text-xl md:text-2xl font-black tracking-tight uppercase">Aarohi AI</h2>
<p class="text-[9px] sm:text-[10px] text-green-400 font-bold uppercase tracking-[0.3em] mt-1">
Expert Farmer Console
</p>
</div>

</div>

<nav class="hidden md:flex items-center gap-8 px-8 py-3 bg-white/5 rounded-full border border-white/10">

<a href="/" class="text-xs font-black text-white hover:text-green-400 uppercase tracking-widest transition">
Home
</a>

<a href="/schemes" class="text-xs font-black text-white hover:text-green-400 uppercase tracking-widest transition">
Govt Money
</a>

<a href="/market" class="text-xs font-black text-white hover:text-green-400 uppercase tracking-widest transition">
Marketplace
</a>

<a href="/community" class="text-xs font-black text-white hover:text-green-400 uppercase tracking-widest transition">
Community
</a>

</nav>

<div class="flex gap-2 sm:gap-4">

<button id="autoReadBtn"
onclick="toggleAutoRead()"
class="bg-blue-500/10 text-blue-400 border border-blue-500/20 px-3 sm:px-5 py-2 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-black uppercase hover:bg-blue-500 hover:text-white transition">
🔊 Auto-read Off
</button>

<button onclick="location.reload()"
class="bg-red-500/10 text-red-400 border border-red-500/20 px-3 sm:px-5 py-2 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-black uppercase hover:bg-red-500 hover:text-white transition">
Clear
</button>

</div>

</header>


<div id="chatMessages">

<div class="ai-bubble">

<div class="flex items-center gap-3 mb-4">
<span class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></span>
<p class="text-[10px] font-black text-green-400 uppercase tracking-widest">
Aarohi Project Intelligence
</p>
</div>

<div class="text-white text-lg sm:text-xl md:text-2xl font-bold leading-tight mb-6" id="welcomeText">

Namaste! 🙏 I am your expert guide.

<br>

I have been trained on the

<span class="text-green-400 underline decoration-wavy underline-offset-4">
Aarohi Project
</span>

to help you with every farming challenge.

</div>

<button class="mt-2 text-green-300 read-btn"
onclick="speakText(document.getElementById('welcomeText').innerText, defaultLang)">
🔊 Read
</button>


<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4 mt-6">

<button onclick="askQuestion('How to sell my crops on Aarohi?')"
class="bg-white/5 hover:bg-green-500 hover:text-black border border-white/10 p-4 sm:p-5 rounded-xl sm:rounded-2xl text-sm font-black text-left uppercase transition">
💰 Sell Harvest
</button>

<button onclick="askQuestion('Show me schemes for small farmers')"
class="bg-white/5 hover:bg-green-500 hover:text-black border border-white/10 p-4 sm:p-5 rounded-xl sm:rounded-2xl text-sm font-black text-left uppercase transition">
🚜 Govt Schemes
</button>

<button onclick="askQuestion('How to call a Vet doctor?')"
class="bg-white/5 hover:bg-green-500 hover:text-black border border-white/10 p-4 sm:p-5 rounded-xl sm:rounded-2xl text-sm font-black text-left uppercase transition">
🏥 Animal Help
</button>

</div>

</div>

</div>


<div class="input-hub">

<div class="max-w-7xl mx-auto flex gap-3 sm:gap-4">

<div class="relative flex-grow">

<input
type="text"
id="userInput"
placeholder="Write your farming question..."
class="custom-input w-full px-5 sm:px-8 py-4 sm:py-6 text-lg sm:text-xl text-white font-bold placeholder-gray-600 outline-none"
onkeypress="if(event.key==='Enter') sendMessage()"
>

<button onclick="startVoiceInput()"
class="absolute right-5 top-1/2 -translate-y-1/2 text-green-400 hover:text-red-500 transition">

<svg class="w-8 h-8 sm:w-10 sm:h-10" fill="currentColor" viewBox="0 0 20 20">

<path fill-rule="evenodd"
d="M7 4a3 3 0 016 0v4a3 3 0 11-6 0V4zm4 10.93A7.001 7.001 0 0017 8a1 1 0 10-2 0A5 5 0 015 8a1 1 0 00-2 0 7.001 7.001 0 006 6.93V17H6a1 1 0 100 2h8a1 1 0 100-2h-3v-2.07z"
clip-rule="evenodd"></path>

</svg>

</button>

</div>

<button onclick="sendMessage()"
class="bg-green-500 text-black px-6 sm:px-12 py-4 sm:py-6 rounded-2xl sm:rounded-3xl font-black text-sm sm:text-lg uppercase tracking-widest shadow-xl hover:bg-green-400 transition active:scale-95">
SEND
</button>

</div>

</div>

</div>


<script src="/js/voiceOver.js"></script>

<script>

const defaultLang = '<%= lang %>';

async function sendMessage() {

const input = document.getElementById('userInput');
const message = input.value.trim();
if (!message) return;

addMessage(message,'user');
input.value='';

showTyping();

try{

const res = await fetch('/ai/analyze',{
method:'POST',
headers:{'Content-Type':'application/json'},
credentials:'same-origin',
body:JSON.stringify({message:message})
});

const data = await res.json();

removeTyping();
addMessage(data.reply,'ai',data.lang || defaultLang);

}catch(e){

removeTyping();
addMessage("I'm sorry, I'm having trouble reaching the Aarohi servers. 🌾",'ai',defaultLang);

}

}

let autoRead=false;

function toggleAutoRead(){

autoRead=!autoRead;

const btn=document.getElementById('autoReadBtn');

btn.textContent=autoRead?'🔊 Auto-read On':'🔊 Auto-read Off';

}

function addMessage(text,type,lang=defaultLang){

const chat=document.getElementById('chatMessages');

const div=document.createElement('div');

if(type==='user'){

div.className="user-bubble text-lg sm:text-xl font-black";
div.innerHTML=text;

}else{

div.className="ai-bubble";

const formatted=text.replace(/(\/[a-z]+)/g,'<a href="$1" class="text-green-400 underline font-black">$1</a>');

div.innerHTML=`
<div class="flex items-center gap-3 mb-4 opacity-50">
<span class="w-2 h-2 bg-green-500 rounded-full"></span>
<p class="text-[10px] font-black text-green-400 uppercase tracking-widest">
Expert Reply
</p>
</div>
<div class="text-white text-lg sm:text-xl font-bold leading-relaxed">
${formatted}
</div>
`;

const btn=document.createElement('button');

btn.className='mt-2 text-green-300 read-btn';

btn.textContent='🔊 Read';

btn.onclick=()=>speakText(text,lang);

div.appendChild(btn);

if(autoRead){speakText(text,lang)}

}

chat.appendChild(div);

chat.scrollTo({top:chat.scrollHeight,behavior:'smooth'});

}

function showTyping(){

const chat=document.getElementById('chatMessages');

const div=document.createElement('div');

div.id='typingIndicator';

div.className="ai-bubble w-fit py-4 px-8";

div.innerHTML=`<div class="flex gap-2">
<div class="w-3 h-3 bg-green-400 rounded-full animate-bounce"></div>
<div class="w-3 h-3 bg-green-400 rounded-full animate-bounce" style="animation-delay:0.1s"></div>
<div class="w-3 h-3 bg-green-400 rounded-full animate-bounce" style="animation-delay:0.2s"></div>
</div>`;

chat.appendChild(div);

chat.scrollTop=chat.scrollHeight;

}

function removeTyping(){

const el=document.getElementById('typingIndicator');

if(el)el.remove();

}

function askQuestion(q){

document.getElementById('userInput').value=q;

sendMessage();

}

function startVoiceInput(){

alert("Listening... Speak your problem clearly.");

}

function speakText(text,lang){

if(lang && window.voiceSetLang){
voiceSetLang(lang);
}

const clean=text.replace(/<[^>]+>/g,'').replace(/\n+/g,' ');

if(window.voiceSpeak){
window.voiceSpeak(clean);
}

}

</script>

</body>
</html>