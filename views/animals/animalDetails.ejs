<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= animal.type %> - <%= animal.breed %> | Aarohi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f7fee7; /* Daylight Mint */
            color: #1a2e05;
        }

        .ambient-canvas {
            position: fixed;
            inset: 0;
            z-index: -1;
            background: 
                radial-gradient(circle at 10% 10%, #ecfccb 0%, transparent 40%),
                radial-gradient(circle at 90% 90%, #d9f99d 0%, transparent 40%);
        }

        .glass-panel-light {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 2px solid #ffffff;
            border-radius: 3rem;
            box-shadow: 0 20px 50px rgba(101, 163, 13, 0.08);
        }

        .btn-call {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            box-shadow: 0 6px 0 #14532d;
            transition: all 0.1s;
        }

        .btn-call:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #14532d;
        }

        .detail-card {
            background: white;
            border: 2px solid #ecfccb;
            border-radius: 2rem;
            transition: all 0.3s ease;
        }

        /* Large Image Viewer */
        .main-img {
            max-height: 500px;
            width: 100%;
            object-fit: cover;
            border-radius: 2.5rem;
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="antialiased min-h-screen pb-24 md:pb-8">

    <div class="ambient-canvas"></div>
    <%- include('../layouts/header') %>

    <main class="max-w-[95%] w-full mx-auto px-2 py-6 relative z-10">

        <div class="flex items-center justify-between mb-8 px-4">
            <a href="/animals" class="inline-flex items-center gap-3 text-lime-900 font-black uppercase text-xs tracking-widest hover:text-lime-600 transition-all group">
                <svg class="w-6 h-6 group-hover:-translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path d="M15 19l-7-7 7-7"></path></svg>
                Back to Market
            </a>

            <% if (user && animal.owner && animal.owner._id.toString() === user._id.toString()) { %>
                <form action="/animals/<%= animal._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                    <button type="submit" class="bg-red-100 text-red-600 border-2 border-red-200 px-6 py-2 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-red-600 hover:text-white transition-all shadow-md">
                        Delete My Listing
                    </button>
                </form>
            <% } %>
        </div>

        <div class="flex flex-col lg:flex-row gap-8">
            
            <div class="lg:w-[60%] space-y-6">
                <div class="glass-panel-light p-4 shadow-2xl">
                    <% if (animal.images && animal.images.length > 0) { %>
                        <img src="/uploads/<%= animal.images[0] %>" class="main-img border-4 border-white shadow-inner" alt="Animal Main Photo">
                        
                        <% if (animal.images.length > 1) { %>
                        <div class="flex gap-4 overflow-x-auto no-scrollbar mt-4 pb-2">
                            <% animal.images.forEach(img => { %>
                                <img src="/uploads/<%= img %>" class="w-24 h-24 rounded-2xl object-cover border-2 border-white shadow-md flex-shrink-0 cursor-pointer hover:border-lime-500 transition-all">
                            <% }) %>
                        </div>
                        <% } %>
                    <% } else { %>
                        <div class="main-img bg-lime-100 flex flex-col items-center justify-center text-lime-300">
                            <span class="text-9xl">🐄</span>
                            <p class="font-black uppercase tracking-widest text-lime-500 mt-4">No Photos Available</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="lg:w-[40%] space-y-6">
                
                <div class="glass-panel-light p-8 md:p-10 relative overflow-hidden">
                    <div class="absolute -top-10 -right-10 opacity-5 pointer-events-none">
                        <svg width="200" height="200" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg>
                    </div>

                    <div class="mb-6">
                        <h1 class="text-5xl font-black text-lime-950 uppercase tracking-tighter leading-none"><%= animal.type %></h1>
                        <p class="text-xl font-bold text-lime-600 mt-2"><%= animal.breed %> Breed</p>
                    </div>

                    <div class="bg-lime-950 text-white rounded-[2rem] p-8 mb-8 shadow-inner flex items-center justify-between">
                        <div class="leading-none">
                            <p class="text-[10px] font-black uppercase text-lime-400 tracking-[0.2em] mb-2">Asking Price</p>
                            <span class="text-5xl font-black tracking-tighter">₹<%= animal.price %></span>
                        </div>
                        <div class="bg-lime-400 text-lime-950 px-4 py-2 rounded-xl font-black text-xl">
                            <%= animal.age %> <span class="text-xs uppercase">Years</span>
                        </div>
                    </div>

                    <div class="detail-card p-6 bg-white/50">
                        <h3 class="text-xs font-black text-lime-800 uppercase tracking-widest mb-3 flex items-center gap-2">
                            <span>📝</span> About this Animal
                        </h3>
                        <p class="text-lg font-medium text-lime-900 leading-relaxed italic">
                            "<%= animal.description || 'No additional details provided by the seller.' %>"
                        </p>
                    </div>
                </div>

                <div class="glass-panel-light p-8 md:p-10 border-lime-400/30">
                    <h3 class="text-xs font-black text-lime-800 uppercase tracking-widest mb-6">Seller Contact Info</h3>
                    
                    <div class="flex items-center gap-6 mb-8">
                        <div class="w-20 h-20 bg-lime-200 rounded-3xl flex items-center justify-center text-4xl border-4 border-white shadow-lg">
                            👤
                        </div>
                        <div>
                            <p class="text-2xl font-black text-lime-950 uppercase tracking-tight"><%= animal.owner ? animal.owner.name : 'Aarohi Farmer' %></p>
                            <p class="text-sm font-bold text-lime-600 uppercase flex items-center gap-2">
                                <span>📍</span> <%= animal.location.village %>, <%= animal.location.district %>
                            </p>
                        </div>
                    </div>

                    <a href="tel:<%= animal.ownerPhone %>" class="hidden md:flex btn-call text-white py-6 rounded-[2rem] font-black text-2xl uppercase tracking-widest items-center justify-center gap-4 shadow-xl active:scale-95 transition-all">
                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
                        Call Farmer
                    </a>
                </div>
            </div>
        </div>
    </main>

    <div class="md:hidden fixed bottom-0 left-0 right-0 p-4 bg-white/80 backdrop-blur-xl border-t border-lime-200 z-[100] shadow-[0_-10px_30px_rgba(0,0,0,0.1)]">
        <a href="tel:<%= animal.ownerPhone %>" class="btn-call text-white w-full py-5 rounded-[2rem] font-black text-xl uppercase tracking-widest flex items-center justify-center gap-3 active:scale-95 transition-all">
            📞 Call Seller Now
        </a>
    </div>

    <%- include('../layouts/footer') %>

</body>
</html>