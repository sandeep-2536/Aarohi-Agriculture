<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="animals.page_title">Animals for Sale - Aarohi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f7fee7; /* Light Lime White */
            color: #1a2e05;
        }

        /* Soft Organic Background */
        .ambient-canvas {
            position: fixed;
            inset: 0;
            z-index: -1;
            background: 
                radial-gradient(circle at 10% 10%, #ecfccb 0%, transparent 40%),
                radial-gradient(circle at 90% 90%, #d9f99d 0%, transparent 40%);
        }

        .glass-card-light {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 2px solid #ffffff;
            border-radius: 2.5rem;
            box-shadow: 0 10px 30px rgba(101, 163, 13, 0.1);
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .glass-card-light:hover {
            transform: translateY(-8px);
            background: rgba(255, 255, 255, 0.9);
            border-color: #bef264;
            box-shadow: 0 20px 40px rgba(101, 163, 13, 0.15);
        }

        .btn-harvest-gold {
            background: linear-gradient(135deg, #facc15 0%, #eab308 100%);
            box-shadow: 0 4px 0 #a16207;
            transition: all 0.1s;
        }

        .btn-harvest-gold:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #a16207;
        }

        .category-badge {
            background: rgba(101, 163, 13, 0.1);
            border: 1px solid rgba(101, 163, 13, 0.2);
            color: #365314;
        }
    </style>
</head>
<body class="antialiased min-h-screen">

    <div class="ambient-canvas"></div>
    <%- include('../layouts/header') %>

    <main class="max-w-[95%] w-full mx-auto px-4 py-8 relative z-10">

        <div class="glass-card-light p-8 md:p-12 mb-10 overflow-hidden relative">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6 relative z-10">
                <div class="text-center md:text-left">
                    <div class="inline-block bg-lime-500 text-white px-4 py-1 rounded-full text-xs font-black uppercase tracking-widest mb-4">
                        Pashu Mandi (Live Market)
                    </div>
                    <h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-none mb-4 text-lime-950">
                        Buy & Sell <span class="text-lime-600">Animals</span>
                    </h1>
                    <p class="text-xl text-lime-800 font-bold uppercase tracking-widest">Connect with local farmers instantly</p>
                </div>

                <a href="/animals/new" class="btn-harvest-gold text-white px-10 py-5 rounded-3xl font-black text-xl uppercase tracking-widest shadow-xl flex items-center gap-3 active:scale-95 transition-all">
                    <span>➕</span>
                    <span data-i18n="animals.hero.btn_list">List My Animal</span>
                </a>
            </div>
            
            <div class="absolute -bottom-10 -right-10 opacity-5 pointer-events-none rotate-12">
                <svg width="300" height="300" viewBox="0 0 24 24" fill="currentColor"><path d="M10,13C10,13 10,11.5 11,10.5C12,9.5 14,9 14,9C14,9 14.5,7 13,5.5C11.5,4 9,4 9,4C9,4 7,4.5 5.5,6C4,7.5 4,10 4,10C4,10 4.5,12 5.5,13C6.5,14 8,14.5 9,14.5C10,14.5 10,13 10,13M18,9C18,9 17.5,7 16,5.5C14.5,4 12,4 12,4C12,4 10,4.5 8.5,6C7,7.5 7,10 7,10C7,10 7.5,12 8.5,13C9.5,14 11,14.5 12,14.5C13,14.5 13,13 13,13C13,13 13,11.5 14,10.5C15,9.5 17,9 17,9C17,9 18,9 18,9Z"/></svg>
            </div>
        </div>

        <% if (animals.length > 0) { %>
            <div class="mb-8 flex items-center gap-4">
                <div class="bg-white px-6 py-2 rounded-full border-2 border-lime-200 shadow-sm flex items-center gap-2">
                    <span class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></span>
                    <span class="font-black text-lime-900 uppercase text-xs tracking-widest">
                        <%= animals.length %> Animals for sale in your area
                    </span>
                </div>
            </div>
        <% } %>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <% animals.forEach(a => { %>
                <div class="glass-card-light overflow-hidden flex flex-col group h-full">
                    
                    <div class="relative h-64 overflow-hidden bg-white">
                        <% if (a.images && a.images.length > 0) { %>
                            <img src="/uploads/<%= a.images[0] %>"
                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                                 alt="<%= a.type %>">
                        <% } else { %>
                            <div class="w-full h-full flex flex-col items-center justify-center bg-lime-50 text-lime-300">
                                <span class="text-7xl">🐄</span>
                                <p class="text-[10px] font-black uppercase mt-2">No Photo Provided</p>
                            </div>
                        <% } %>
                        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-4 py-1.5 rounded-xl text-xs font-black text-lime-900 uppercase border border-lime-100 shadow-sm">
                            <%= a.type %>
                        </div>
                    </div>

                    <div class="p-6 flex flex-col flex-grow">
                        <div class="flex justify-between items-start mb-4">
                            <h3 class="text-2xl font-black text-lime-950 leading-none"><%= a.breed %></h3>
                        </div>

                        <div class="space-y-3 mb-6">
                            <div class="flex items-center gap-2 text-lime-800">
                                <span class="text-lg">📍</span>
                                <span class="font-bold text-sm truncate"><%= a.location.village %>, <%= a.location.district %></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="category-badge px-3 py-1 rounded-lg text-[10px] font-black uppercase">
                                    Quality Assured
                                </span>
                                <span class="category-badge px-3 py-1 rounded-lg text-[10px] font-black uppercase">
                                    Local
                                </span>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <div class="bg-lime-950 text-white rounded-2xl p-4 mb-4 flex items-center justify-between shadow-inner">
                                <span class="text-[10px] font-black uppercase text-lime-400">Fixed Price</span>
                                <span class="text-3xl font-black tracking-tighter">₹<%= a.price %></span>
                            </div>

                            <a href="/animals/<%= a._id %>"
                               class="w-full bg-lime-500 hover:bg-lime-600 text-white py-4 rounded-2xl font-black text-sm uppercase tracking-widest transition-all shadow-lg active:scale-95 flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                <span data-i18n="animals.card.view_details">View Details</span>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <% if (animals.length === 0) { %>
            <div class="glass-card-light p-20 text-center my-10">
                <div class="text-9xl mb-6">🐄</div>
                <h3 class="text-4xl font-black text-lime-900 mb-4" data-i18n="animals.no_results.title">Market is Empty</h3>
                <p class="text-xl text-lime-700 font-medium mb-10" data-i18n="animals.no_results.desc">Be the first farmer to list your livestock here!</p>
                <a href="/animals/new" class="btn-harvest-gold text-white px-10 py-5 rounded-3xl font-black text-xl shadow-xl uppercase tracking-widest">
                    Add First Listing
                </a>
            </div>
        <% } %>

        <div class="mt-20 text-center pb-10">
            <a href="/" class="inline-flex items-center gap-4 bg-white hover:bg-lime-50 text-lime-900 px-10 py-5 rounded-[2rem] font-black text-lg uppercase tracking-widest transition-all border-4 border-lime-100 shadow-xl group">
                <svg class="w-6 h-6 group-hover:-translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                <span data-i18n="nav.back_home">Back to Farm Hub</span>
            </a>
        </div>

    </main>

    <%- include('../layouts/footer') %>

</body>
</html>