<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Animal Listing - Aarohi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f7fee7; /* Daylight Mint */
            color: #1a2e05;
        }

        .glass-card-light {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border: 2px solid #ffffff;
            border-radius: 3rem;
            box-shadow: 0 20px 50px rgba(101, 163, 13, 0.1);
        }

        .input-box {
            background: #ffffff;
            border: 2px solid #d9f99d;
            border-radius: 1.5rem;
            padding: 1rem 1.5rem;
            font-size: 1.25rem;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .input-box:focus {
            border-color: #65a30d;
            box-shadow: 0 0 15px rgba(101, 163, 13, 0.2);
            outline: none;
        }

        .btn-harvest {
            background: linear-gradient(135deg, #facc15 0%, #eab308 100%);
            box-shadow: 0 6px 0 #a16207;
            transition: all 0.1s;
        }

        .btn-harvest:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #a16207;
        }

        .step-badge {
            background: #ecfccb;
            color: #365314;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-weight: 900;
        }
    </style>
</head>
<body class="antialiased min-h-screen">

    <%- include('../layouts/header') %>

    <div class="fixed inset-0 z-[-1] opacity-50">
        <div class="absolute top-0 left-0 w-96 h-96 bg-lime-200 rounded-full blur-[100px]"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-emerald-200 rounded-full blur-[100px]"></div>
    </div>

    <main class="max-w-[95%] w-full mx-auto px-4 py-10">

        <div class="mb-8">
            <a href="/animals" class="inline-flex items-center gap-3 text-lime-800 font-black uppercase text-xs tracking-widest hover:text-lime-600 transition-all group">
                <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
                Back to Market
            </a>
        </div>

        <div class="glass-card-light overflow-hidden relative">
            <div class="absolute top-10 right-10 opacity-10 pointer-events-none">
                <svg width="200" height="200" viewBox="0 0 24 24" fill="currentColor"><path d="M10,13C10,13 10,11.5 11,10.5C12,9.5 14,9 14,9C14,9 14.5,7 13,5.5C11.5,4 9,4 9,4C9,4 7,4.5 5.5,6C4,7.5 4,10 4,10C4,10 4.5,12 5.5,13C6.5,14 8,14.5 9,14.5C10,14.5 10,13 10,13M18,9C18,9 17.5,7 16,5.5C14.5,4 12,4 12,4C12,4 10,4.5 8.5,6C7,7.5 7,10 7,10C7,10 7.5,12 8.5,13C9.5,14 11,14.5 12,14.5C13,14.5 13,13 13,13C13,13 13,11.5 14,10.5C15,9.5 17,9 17,9C17,9 18,9 18,9Z"/></svg>
            </div>

            <div class="p-10 border-b border-lime-100 bg-white/50">
                <h1 class="text-4xl md:text-5xl font-black tracking-tighter text-lime-950 uppercase leading-none">
                    Sell Your <span class="text-lime-600">Livestock</span>
                </h1>
                <p class="text-lg text-lime-700 font-bold mt-2 uppercase tracking-widest">Reach hundreds of local farmers instantly</p>
            </div>

            <form action="/animals" method="POST" enctype="multipart/form-data" class="p-10 md:p-16 space-y-16">
                
                <section>
                    <div class="flex items-center gap-4 mb-8">
                        <span class="step-badge">1</span>
                        <h2 class="text-2xl font-black text-lime-900 uppercase tracking-tight">Animal Details</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">
                        <div>
                            <label class="block text-xs font-black text-lime-700 uppercase tracking-widest mb-3">Choose Animal</label>
                            <select name="type" required class="input-box w-full appearance-none">
                                <option value="Cow">🐄 Cow / ಆಕಳು</option>
                                <option value="Goat">🐐 Goat / ಮೇಕೆ</option>
                                <option value="Buffalo">🐃 Buffalo / ಎಮ್ಮೆ</option>
                                <option value="Sheep">🐑 Sheep / ಕುರಿ</option>
                                <option value="Bull">🐂 Bull / ಎತ್ತು</option>
                                <option value="Other">📦 Other</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-black text-lime-700 uppercase tracking-widest mb-3">Breed (ತಳಿ)</label>
                            <input type="text" name="breed" required placeholder="e.g. Jersey, Sahiwal" class="input-box w-full">
                        </div>

                        <div>
                            <label class="block text-xs font-black text-lime-700 uppercase tracking-widest mb-3">Age (ವಯಸ್ಸು)</label>
                            <input type="number" name="age" required placeholder="Years" class="input-box w-full">
                        </div>

                        <div>
                            <label class="block text-xs font-black text-lime-700 uppercase tracking-widest mb-3">Price (ಬೆಲೆ)</label>
                            <div class="relative">
                                <span class="absolute left-5 top-1/2 -translate-y-1/2 font-black text-lime-600 text-xl">₹</span>
                                <input type="number" name="price" required placeholder="Enter Amount" class="input-box w-full pl-12">
                            </div>
                        </div>
                    </div>
                </section>

                <section>
                    <div class="flex items-center gap-4 mb-8">
                        <span class="step-badge">2</span>
                        <h2 class="text-2xl font-black text-lime-900 uppercase tracking-tight">Photos & Info</h2>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                        <div>
                            <label class="block text-xs font-black text-lime-700 uppercase tracking-widest mb-3">Tell us more (optional)</label>
                            <textarea name="description" rows="5" placeholder="Mention milk yield, health, or behavior..." class="input-box w-full resize-none"></textarea>
                        </div>

                        <div>
                            <label class="block text-xs font-black text-lime-700 uppercase tracking-widest mb-3">Upload Pictures</label>
                            <input type="file" name="images" accept="image/*" multiple id="imageUpload" class="hidden">
                            <label for="imageUpload" class="flex flex-col items-center justify-center border-4 border-dashed border-lime-200 rounded-3xl p-10 bg-lime-50 hover:bg-white hover:border-lime-500 transition-all cursor-pointer group">
                                <span class="text-6xl mb-4 group-hover:scale-110 transition-transform">📸</span>
                                <p class="text-lg font-black text-lime-900 uppercase tracking-tighter">Tap to add photos</p>
                                <p class="text-sm font-bold text-lime-500 mt-2 text-center underline">Farmers buy faster when they see photos!</p>
                            </label>
                        </div>
                    </div>
                </section>

                <section>
                    <div class="flex items-center gap-4 mb-8">
                        <span class="step-badge">3</span>
                        <h2 class="text-2xl font-black text-lime-900 uppercase tracking-tight">Your Location</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <div>
                            <label class="block text-xs font-black text-lime-700 uppercase tracking-widest mb-3">Village</label>
                            <input type="text" name="village" required placeholder="Your Village" class="input-box w-full">
                        </div>
                        <div>
                            <label class="block text-xs font-black text-lime-700 uppercase tracking-widest mb-3">Taluk</label>
                            <input type="text" name="taluk" required placeholder="Your Taluk" class="input-box w-full">
                        </div>
                        <div>
                            <label class="block text-xs font-black text-lime-700 uppercase tracking-widest mb-3">District</label>
                            <input type="text" name="district" required placeholder="Your District" class="input-box w-full">
                        </div>
                    </div>
                </section>

                <div class="pt-10 border-t border-lime-100 flex flex-col md:flex-row gap-6">
                    <button type="submit" class="btn-harvest flex-1 py-6 rounded-[2rem] text-white font-black text-2xl uppercase tracking-[0.2em] shadow-xl flex items-center justify-center gap-4">
                        Post Listing ➜
                    </button>
                    <a href="/animals" class="px-12 py-6 rounded-[2rem] bg-white border-4 border-lime-100 text-lime-800 font-black text-xl uppercase tracking-widest text-center hover:bg-red-50 hover:text-red-600 hover:border-red-100 transition-all">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </main>

    <%- include('../layouts/footer') %>

</body>
</html>