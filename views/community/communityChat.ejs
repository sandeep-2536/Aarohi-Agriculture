<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farmer Community Hub - Aarohi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script src="/socket.io/socket.io.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Montserrat', 'sans-serif'] },
                    colors: {
                        'farm-deep': '#020d08',
                        'farm-accent': '#10b981',
                        'farm-gold': '#fbbf24'
                    }
                }
            }
        }
    </script>
    
    <style>
        body, html {
            height: 100%;
            margin: 0;
            background-color: #020d08;
            color: white;
            overflow: hidden;
        }

        /* Ambient Nature Canvas Background */
        .ambient-bg {
            position: fixed;
            inset: 0;
            z-index: 0;
            background: linear-gradient(to bottom, rgba(2, 13, 8, 0.9), rgba(5, 25, 15, 0.95)), url('home_bg.jpg');
            background-size: cover;
            background-position: center;
        }

        /* Glassmorphism Panels */
        .glass-panel {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Message Bubbles */
        .message-mine-bubble {
            background: linear-gradient(135deg, #10b981 0%, #065f46 100%);
            border-radius: 1.5rem 1.5rem 0.2rem 1.5rem;
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.2);
        }

        .message-other-bubble {
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.5rem 1.5rem 1.5rem 0.2rem;
        }

        /* Tactical Scrollbar */
        #messages::-webkit-scrollbar { width: 4px; }
        #messages::-webkit-scrollbar-thumb { background: #10b981; border-radius: 10px; }

        /* Floating Input Hub */
        .input-hub {
            background: rgba(5, 25, 15, 0.9);
            backdrop-filter: blur(30px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        @keyframes popIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }
        .animate-pop { animation: popIn 0.3s ease-out; }
    </style>
</head>
<body class="antialiased">

    <div class="ambient-bg"></div>

    <div class="relative z-10 flex flex-col h-screen">
        
        <%- include("../layouts/header") %>

        <div class="flex flex-1 overflow-hidden max-w-[1600px] mx-auto w-full px-4 py-4 gap-6">
            
            <aside class="hidden lg:flex flex-col w-80 gap-6">
                <div class="glass-panel rounded-[2rem] p-6 text-center">
                    <div class="relative inline-block mb-4">
                        <img src="<%= user.profileImage || '/images/default-user.svg' %>" 
                             class="w-24 h-24 rounded-full object-cover border-4 border-farm-accent shadow-2xl mx-auto">
                        <span class="absolute bottom-1 right-1 w-6 h-6 bg-green-500 border-4 border-farm-deep rounded-full"></span>
                    </div>
                    <h2 class="text-xl font-black tracking-tighter uppercase"><%= user.name %></h2>
                    <p class="text-farm-accent text-xs font-bold uppercase tracking-widest mt-1">
                        <%= user.village ? user.village : 'Village Farmer' %>
                    </p>
                </div>

                <div class="glass-panel rounded-[2rem] p-8 flex-1 overflow-y-auto">
                    <h3 class="text-xs font-black text-gray-500 uppercase tracking-[0.3em] mb-6">Group Rules</h3>
                    <ul class="space-y-6">
                        <li class="flex items-start gap-4">
                            <span class="bg-farm-accent/20 p-2 rounded-lg text-farm-accent text-lg">🤝</span>
                            <p class="text-sm font-bold text-gray-300">Respect your neighbors</p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="bg-farm-accent/20 p-2 rounded-lg text-farm-accent text-lg">🌱</span>
                            <p class="text-sm font-bold text-gray-300">Share crop tips freely</p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="bg-farm-accent/20 p-2 rounded-lg text-farm-accent text-lg">🎤</span>
                            <p class="text-sm font-bold text-gray-300">Voice chat is welcome</p>
                        </li>
                    </ul>
                </div>
            </aside>

            <main class="flex-1 flex flex-col glass-panel rounded-[2.5rem] overflow-hidden shadow-2xl">
                
                <div class="p-6 border-b border-white/5 bg-white/5 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-3 h-3 bg-farm-accent rounded-full animate-pulse shadow-[0_0_10px_#10b981]"></div>
                        <div>
                            <h1 class="text-2xl font-black tracking-tighter uppercase leading-none">Farmer Discussion</h1>
                            <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mt-1">Live Community Channel</p>
                        </div>
                    </div>
                    <button id="refreshBtn" class="bg-white/5 hover:bg-white/10 px-6 py-2 rounded-full text-[10px] font-black uppercase tracking-widest border border-white/10 transition-all">
                        Refresh
                    </button>
                </div>

                <div id="messages" class="flex-1 overflow-y-auto p-8 space-y-8">
                    <% messages.forEach(msg => { %>
                    <div class="animate-pop <%= (msg.user._id.toString() === user._id.toString()) ? 'flex justify-end' : 'flex justify-start' %>" data-id="<%= msg._id %>">
                        <div class="flex <%= (msg.user._id.toString() === user._id.toString()) ? 'flex-row-reverse' : 'flex-row' %> gap-4 max-w-[80%] md:max-w-[60%]">
                            <img src="<%= msg.user.profileImage || '/images/default-user.png' %>" 
                                 class="w-12 h-12 rounded-2xl object-cover border-2 border-white/10 shadow-lg flex-shrink-0">
                            
                            <div class="flex flex-col <%= (msg.user._id.toString() === user._id.toString()) ? 'items-end' : 'items-start' %>">
                                <div class="flex items-baseline gap-2 mb-2 opacity-50">
                                    <span class="text-[10px] font-black uppercase tracking-widest"><%= msg.user.name %></span>
                                    <span class="text-[9px] font-bold">
                                        <%= new Date(msg.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                                    </span>
                                </div>
                                <div class="<%= (msg.user._id.toString() === user._id.toString()) ? 'message-mine-bubble' : 'message-other-bubble' %> px-6 py-4">
                                    <p class="text-lg font-bold leading-relaxed whitespace-pre-wrap"><%= msg.text %></p>
                                    <% if (msg.image) { %>
                                        <img src="<%= msg.image %>" class="mt-4 rounded-xl max-w-full cursor-zoom-in border border-white/10" onclick="openImage(this.src)">
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>

                <div class="input-hub p-6">
                    <form id="sendForm" class="max-w-5xl mx-auto flex flex-col gap-4">
                        <div class="relative group">
                            <textarea id="messageInput" placeholder="Talk with farmers... (Use Voice 🎤)"
                                class="w-full bg-white/5 border-2 border-white/10 rounded-3xl px-8 py-5 text-xl font-bold placeholder-gray-600 focus:border-farm-accent transition-all outline-none resize-none"
                                rows="2"></textarea>
                            
                            <label class="absolute right-6 top-1/2 -translate-y-1/2 bg-farm-accent/10 hover:bg-farm-accent p-3 rounded-2xl cursor-pointer transition-all border border-farm-accent/20 group">
                                <input id="imageInput" type="file" accept="image/*" class="hidden"/>
                                <svg class="w-6 h-6 text-farm-accent group-hover:text-farm-deep" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                                </svg>
                            </label>
                        </div>

                        <div class="flex gap-4">
                            <button type="button" id="voiceBtn" class="bg-red-500 hover:bg-red-600 text-white px-10 py-5 rounded-3xl font-black uppercase text-xs tracking-widest transition-all shadow-lg active:scale-95 flex items-center gap-3">
                                <span>🎤 Speak</span>
                            </button>
                            <button type="submit" class="flex-1 bg-farm-accent hover:bg-emerald-400 text-farm-deep px-10 py-5 rounded-3xl font-black uppercase text-sm tracking-widest transition-all shadow-xl shadow-farm-accent/20 active:scale-95 flex items-center justify-center gap-3">
                                <span>Send Message</span>
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>
            </main>
        </div>
    </div>

    <div id="imageModal" class="fixed inset-0 bg-black/95 backdrop-blur-xl flex items-center justify-center z-[100] hidden" onclick="this.classList.add('hidden')">
        <img id="modalImg" src="" class="max-w-[90%] max-h-[90%] rounded-2xl shadow-2xl object-contain border border-white/10">
    </div>

    <script>
        window.CURRENT_USER = {
            _id: "<%= user._id %>",
            name: "<%= user.name %>",
            profileImage: "<%= user.profileImage || '/images/default-user.svg' %>"
        };
        window.CHAT_ROOM = { id: "<%= room._id %>" };

        function openImage(src) {
            document.getElementById('modalImg').src = src;
            document.getElementById('imageModal').classList.remove('hidden');
        }

        // Keep language specific greeting
        window.addEventListener('DOMContentLoaded', () => {
            const lang = localStorage.getItem("aarohi_lang") || "en";
            const greeting = {
                en: "You entered the Community Hub. Share ideas and learn from fellow farmers.",
                hi: "आपने सामुदायिक हब में प्रवेश किया है। विचार साझा करें और साथी किसानों से सीखें।",
                kn: "ನೀವು ಸಮುದಾಯ ಹಬ್‌ಗೆ ಸೇರಿದ್ದೀರಿ. ವಿಚಾರಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಿ ಮತ್ತು ಸಹ ರೈತರಿಂದ ಕಲಿಯಿರಿ."
            };
            if(window.voiceSpeak) window.voiceSpeak(greeting[lang]);
        });
    </script>
    <script src="/js/chat.js"></script>
</body>
</html>