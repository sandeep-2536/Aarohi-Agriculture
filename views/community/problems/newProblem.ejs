<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report Problem - Aarohi Agriculture</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #020d08;
            color: white;
            min-height: 100vh;
        }

        /* Ambient Nature Background */
        .ambient-canvas {
            position: fixed;
            inset: 0;
            z-index: -1;
            background: linear-gradient(to bottom, rgba(2, 13, 8, 0.9), rgba(5, 25, 15, 0.95)), url('/home_bg.jpg');
            background-size: cover;
            background-position: center;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 2.5rem;
        }

        .input-field {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.5rem;
            color: white;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .input-field:focus {
            background: rgba(255, 255, 255, 0.1);
            border-color: #4ade80;
            box-shadow: 0 0 20px rgba(74, 222, 128, 0.2);
            outline: none;
        }

        .btn-harvest {
            background: linear-gradient(to bottom, #FFB703, #fb8500);
            box-shadow: 0 4px 0 #8a4a00;
            transition: all 0.1s;
        }

        .btn-harvest:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #8a4a00;
        }

        .drop-zone {
            border: 3px dashed rgba(255, 255, 255, 0.2);
            transition: all 0.3s;
        }

        .drop-zone:hover {
            border-color: #4ade80;
            background: rgba(74, 222, 128, 0.05);
        }
    </style>
</head>
<body class="antialiased">

    <div class="ambient-canvas"></div>

    <%- include("../../layouts/header") %>

    <main class="max-w-4xl mx-auto px-6 py-12 relative z-10">
        
        <div class="text-center mb-12 animate-fade-in">
            <div class="inline-flex items-center justify-center w-24 h-24 bg-green-500/20 rounded-3xl mb-6 border border-green-500/30">
                <span class="text-5xl">📢</span>
            </div>
            <h1 class="text-5xl md:text-6xl font-black mb-4 tracking-tighter uppercase leading-none">
                Report <span class="text-green-400">Problem</span>
            </h1>
            <p class="text-xl text-gray-400 font-bold uppercase tracking-widest">
                Our community experts will help you find a solution.
            </p>
        </div>

        <div class="glass-card p-8 md:p-12 shadow-2xl overflow-hidden relative">
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-green-500/10 rounded-full blur-3xl"></div>

            <form action="/community/problems/new" method="POST" enctype="multipart/form-data" class="space-y-10">
                
                <div>
                    <label class="flex items-center gap-3 text-white font-black text-xs uppercase tracking-[0.3em] mb-4">
                        <span class="w-8 h-8 bg-green-500 text-black rounded-lg flex items-center justify-center">1</span>
                        Describe your problem
                    </label>
                    <textarea 
                        name="text" 
                        rows="6"
                        placeholder="Ex: My tomato leaves have yellow spots. I used urea 2 days ago but it didn't help..."
                        class="input-field w-full p-6 text-xl font-bold resize-none placeholder-gray-600"
                        required
                    ></textarea>
                    <p class="text-[10px] text-gray-500 mt-3 font-black uppercase tracking-widest flex items-center gap-2">
                        <span class="text-yellow-500">💡</span> Tip: Mention your crop name and symptoms.
                    </p>
                </div>

                <div>
                    <label class="flex items-center gap-3 text-white font-black text-xs uppercase tracking-[0.3em] mb-4">
                        <span class="w-8 h-8 bg-green-500 text-black rounded-lg flex items-center justify-center">2</span>
                        Show us a photo
                    </label>
                    
                    <div class="relative">
                        <input type="file" name="image" id="imageInput" accept="image/*" class="hidden" onchange="previewImage(event)">
                        <label for="imageInput" class="drop-zone block w-full rounded-3xl p-12 text-center cursor-pointer group">
                            <div class="bg-white/5 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
                                <svg class="w-10 h-10 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                            <p class="text-xl font-black text-white group-hover:text-green-400 transition-colors uppercase tracking-tighter">Tap to upload photo</p>
                            <p class="text-xs font-bold text-gray-500 mt-2">Clear photos help experts identify pests faster.</p>
                        </label>
                    </div>

                    <div id="imagePreview" class="hidden mt-6 animate-popIn">
                        <div class="relative rounded-3xl overflow-hidden border-4 border-white/10 shadow-2xl">
                            <img id="previewImg" src="" class="w-full h-80 object-cover">
                            <button type="button" onclick="removeImage()" 
                                    class="absolute top-4 right-4 bg-red-500 hover:bg-red-600 text-white p-4 rounded-2xl shadow-xl transition active:scale-90">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="bg-white/5 border border-white/10 rounded-[2rem] p-6 space-y-4">
                    <h3 class="text-[10px] font-black text-green-400 uppercase tracking-[0.3em]">Submission Tips</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="flex items-center gap-3 text-sm font-bold text-gray-300">
                            <span class="text-lg">📍</span> Local weather details
                        </div>
                        <div class="flex items-center gap-3 text-sm font-bold text-gray-300">
                            <span class="text-lg">🧪</span> List any fertilizers used
                        </div>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-white/5">
                    <button type="submit" class="btn-harvest flex-1 py-6 rounded-3xl font-black text-xl uppercase tracking-widest text-farm-deep flex items-center justify-center gap-3">
                        Submit Request ➜
                    </button>
                    <a href="/community/problems" class="bg-white/10 hover:bg-white/20 text-white py-6 px-10 rounded-3xl font-black text-xl uppercase tracking-widest text-center transition">
                        Back
                    </a>
                </div>
            </form>
        </div>
    </main>

    <%- include("../../layouts/footer") %>

    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('previewImg').src = e.target.result;
                    document.getElementById('imagePreview').classList.remove('hidden');
                    document.getElementById('imagePreview').classList.add('flex');
                };
                reader.readAsDataURL(file);
            }
        }

        function removeImage() {
            document.getElementById('imageInput').value = '';
            document.getElementById('imagePreview').classList.add('hidden');
            document.getElementById('imagePreview').classList.remove('flex');
            document.getElementById('previewImg').src = '';
        }
    </script>
</body>
</html>