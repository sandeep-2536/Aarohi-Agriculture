<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discussion - Aarohi Agriculture</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #020d08;
            color: #e2e8f0;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Full Screen Ambient Canvas */
        .ambient-canvas {
            position: fixed;
            inset: 0;
            z-index: -1;
            background: linear-gradient(to bottom, rgba(2, 13, 8, 0.9), rgba(5, 25, 15, 0.95)), url('/home_bg.jpg');
            background-size: cover;
            background-position: center;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .input-field {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.5rem;
            color: white;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .input-field:focus {
            background: rgba(255, 255, 255, 0.1);
            border-color: #4ade80;
            outline: none;
        }

        .btn-harvest {
            background: linear-gradient(to bottom, #FFB703, #fb8500);
            box-shadow: 0 4px 0 #8a4a00;
        }

        /* 100% Width Containers */
        .content-grid {
            display: grid;
            grid-template-columns: 1fr 1.5fr;
            gap: 2rem;
            height: calc(100vh - 120px);
        }

        @media (max-width: 1024px) {
            .content-grid {
                grid-template-columns: 1fr;
                height: auto;
            }
        }

        .custom-scroll::-webkit-scrollbar { width: 5px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #10b981; border-radius: 10px; }
    </style>
</head>
<body class="antialiased">

    <div class="ambient-canvas"></div>

    <%- include("../../layouts/header") %>

    <main class="w-[96%] mx-auto py-6 relative z-10">
        
        <div class="flex items-center justify-between mb-6 px-4">
            <a href="/community/problems" 
               class="bg-white/5 hover:bg-white/10 border border-white/10 px-6 py-3 rounded-2xl text-xs font-black uppercase tracking-widest transition flex items-center gap-3 text-green-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Back to Problems
            </a>
            <div class="hidden md:flex items-center gap-3">
                <span class="w-3 h-3 bg-green-500 rounded-full animate-pulse shadow-[0_0_10px_#10b981]"></span>
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Active Community Discussion</p>
            </div>
        </div>

        <div class="content-grid">
            
            <section class="flex flex-col gap-6 overflow-y-auto custom-scroll pr-2">
                <div class="glass-panel rounded-[2.5rem] p-8 md:p-10 shadow-2xl relative overflow-hidden">
                    <div class="flex items-center gap-5 mb-8">
                        <div class="relative">
                            <img src="<%= problem.user.profileImage || '/images/default-user.svg' %>" 
                                 class="w-20 h-20 rounded-3xl object-cover border-4 border-green-500/20 shadow-xl">
                            <div class="absolute -bottom-2 -right-2 bg-green-500 text-black px-3 py-1 rounded-lg font-black text-[10px] uppercase">Farmer</div>
                        </div>
                        <div>
                            <h2 class="text-3xl font-black tracking-tighter text-white uppercase"><%= problem.user.name %></h2>
                            <p class="text-xs font-bold text-gray-400 tracking-widest uppercase mt-1">
                                Posted <%= new Date(problem.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long' }) %>
                            </p>
                        </div>
                    </div>

                    <div class="prose prose-invert max-w-none mb-10">
                        <p class="text-2xl font-bold text-gray-200 leading-snug whitespace-pre-line">
                            "<%= problem.text %>"
                        </p>
                    </div>

                    <% if (problem.image) { %>
                    <div class="rounded-[2rem] overflow-hidden border-4 border-white/5 shadow-2xl group cursor-zoom-in">
                        <img src="<%= problem.image %>" 
                             class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700" 
                             alt="Problem evidence"
                             onclick="openImageModal(this.src)">
                    </div>
                    <% } %>

                    <div class="mt-8 pt-8 border-t border-white/5 flex items-center justify-between">
                        <div class="flex items-center gap-3 text-green-400">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"></path></svg>
                            <span class="text-xl font-black"><%= comments.length %> Expert Responses</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="flex flex-col gap-6 glass-panel rounded-[2.5rem] overflow-hidden shadow-2xl">
                <div class="p-8 border-b border-white/5 bg-white/5 flex items-center justify-between">
                    <h3 class="text-2xl font-black tracking-tighter uppercase text-white">Solutions & Support</h3>
                    <div class="text-[10px] font-black text-green-400 uppercase tracking-widest">Share what you know</div>
                </div>

                <div class="flex-1 overflow-y-auto p-8 space-y-8 custom-scroll">
                    <% if (comments.length === 0) { %>
                    <div class="flex flex-col items-center justify-center py-20 opacity-20">
                        <span class="text-8xl mb-4">🌾</span>
                        <h4 class="text-2xl font-black uppercase tracking-widest">Be the first to help</h4>
                    </div>
                    <% } else { %>
                        <% comments.forEach((comment, index) => { %>
                        <div class="flex gap-6 items-start group">
                            <img src="<%= comment.user.profileImage || '/images/default-user.svg' %>" 
                                 class="w-14 h-14 rounded-2xl object-cover border-2 border-white/10 group-hover:border-green-400 transition-colors">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <h4 class="text-lg font-black text-white uppercase tracking-tighter"><%= comment.user.name %></h4>
                                    <span class="text-[10px] font-bold text-gray-500 uppercase">
                                        <%= new Date(comment.createdAt).toLocaleDateString('en-IN') %>
                                    </span>
                                    <% if (index === 0) { %>
                                    <span class="bg-green-500/10 text-green-400 border border-green-500/20 px-3 py-1 rounded-lg text-[9px] font-black uppercase tracking-widest ml-auto">Expert Pioneer</span>
                                    <% } %>
                                </div>
                                <div class="bg-white/5 border border-white/5 p-6 rounded-3xl rounded-tl-none">
                                    <p class="text-gray-300 font-medium leading-relaxed whitespace-pre-line text-lg">
                                        <%= comment.text %>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    <% } %>
                </div>

                <div class="p-8 bg-black/40 border-t border-white/5">
                    <h4 class="text-xs font-black text-green-400 uppercase tracking-widest mb-4">Your Expert Advice</h4>
                    <form action="/community/problems/<%= problem._id %>/comment" method="POST" class="space-y-4">
                        <textarea 
                            name="text" 
                            rows="4"
                            placeholder="Tell the farmer what to do, what medicine to use, or share your experience..."
                            class="input-field w-full p-6 text-xl font-bold resize-none placeholder-gray-700"
                            required
                        ></textarea>
                        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                            <div class="flex items-center gap-3 opacity-40">
                                <span class="text-xl">🤝</span>
                                <p class="text-xs font-bold uppercase tracking-widest text-white">Supporting Rural Progress</p>
                            </div>
                            <button type="submit" 
                                    class="btn-harvest w-full sm:w-auto px-12 py-5 rounded-2xl font-black text-xl uppercase tracking-widest text-black transition-all active:scale-95 flex items-center justify-center gap-3">
                                Post Solution
                                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"></path></svg>
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </main>

    <div id="imageModal" class="fixed inset-0 bg-black/95 backdrop-blur-2xl flex items-center justify-center z-[100] hidden p-6" onclick="closeImageModal()">
        <img id="modalImage" src="" class="max-w-[95%] max-h-[95%] rounded-3xl shadow-2xl object-contain border border-white/10">
    </div>

    <%- include("../../layouts/footer") %>

    <script>
        function openImageModal(src) {
            document.getElementById('modalImage').src = src;
            document.getElementById('imageModal').classList.remove('hidden');
        }
        function closeImageModal() {
            document.getElementById('imageModal').classList.add('hidden');
        }
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeImageModal(); });
    </script>
</body>
</html>