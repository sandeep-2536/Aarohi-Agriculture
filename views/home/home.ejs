<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aarohi Agriculture - Smart Farming</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Montserrat', 'sans-serif'] },
                    animation: {
                        'slow-pan': 'pan 30s linear infinite',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        pan: {
                            '0%': { transform: 'scale(1.1) translateX(0)' },
                            '50%': { transform: 'scale(1.1) translateX(-5%)' },
                            '100%': { transform: 'scale(1.1) translateX(0)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-20px)' },
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Full Page Immersion */
        body, html {
            height: 100%;
            margin: 0;
            background: #05190f; /* Deep farm green base */
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 2rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-panel:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: #4ade80;
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .hero-canvas {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* Image Mask for better recognition */
        .img-mask {
            mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
            -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
        }
    </style>
</head>
<body class="text-white antialiased" data-i18n-voice="home.voiceIntro">

    <%- include("../layouts/header") %>

    <main class="hero-canvas">
        <div class="fixed inset-0 z-0 overflow-hidden">
            <img src="home_bg.jpg" alt="Background" class="w-full h-full object-cover animate-slow-pan opacity-40">
            <div class="absolute inset-0 bg-gradient-to-b from-[#05190f]/90 via-transparent to-[#05190f]"></div>
        </div>

        <section class="relative z-10 flex-grow flex flex-col items-center justify-center px-6 pt-20">
            <div class="text-center mb-12 animate-fade-in">
                <h1 class="text-6xl md:text-8xl font-black mb-4 tracking-tighter leading-none" data-i18n="home.heroTitle">
                    Upliftment of <span class="text-green-400 drop-shadow-[0_0_15px_rgba(74,222,128,0.5)]">Farmers</span>
                </h1>
                <p class="text-xl md:text-2xl text-gray-300 font-semibold tracking-wide uppercase" data-i18n="home.heroSubtitle">Your Digital Agriculture Assistant</p>
            </div>

            <p class="text-lg text-gray-300 font-medium mb-6" data-i18n="home.prompt">Tap or Speak to use the App</p>
            <div class="relative flex items-center justify-center mb-20">
                <div class="absolute w-40 h-40 bg-green-500 rounded-full animate-ping opacity-20"></div>
                <div class="absolute w-56 h-56 bg-green-400 rounded-full animate-pulse opacity-10"></div>
                
                <button onclick="startVoiceCommand()" class="relative z-20 bg-white text-green-900 w-32 h-32 rounded-full shadow-[0_0_50px_rgba(255,255,255,0.3)] flex flex-col items-center justify-center hover:scale-110 transition-transform active:scale-95 group">
                    <svg class="w-14 h-14 group-hover:text-green-600 transition-colors" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M7 4a3 3 0 016 0v4a3 3 0 11-6 0V4zm4 10.93A7.001 7.001 0 0017 8a1 1 0 10-2 0A5 5 0 015 8a1 1 0 00-2 0 7.001 7.001 0 006 6.93V17H6a1 1 0 100 2h8a1 1 0 100-2h-3v-2.07z"/>
                    </svg>
                    <span class="text-[10px] font-black uppercase tracking-tighter mt-1" data-i18n="home.speakNow">Tap to Speak</span>
                </button>
            </div>
        </section>

        <section class="relative z-10 max-w-7xl mx-auto px-6 pb-24">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">

                <div onclick="window.location.href='/schemes'" class="glass-panel group cursor-pointer overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1760872645824-49f21b002e61?w=600" class="w-full h-48 object-cover img-mask group-hover:scale-110 transition-transform duration-700" alt="Schemes">
                    <div class="p-6">
                        <h3 class="text-3xl font-black text-white" data-i18n="home.featSchemes">Govt Schemes</h3>
                        <p class="text-green-400 font-bold uppercase text-sm tracking-widest">Funds</p>
                    </div>
                </div>

                <div onclick="window.location.href='/ai/assistant'" class="glass-panel group cursor-pointer overflow-hidden border-blue-500/30">
                    <img src="https://plus.unsplash.com/premium_photo-1683121710572-7723bd2e235d?q=80&w=1332&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="w-full h-48 object-cover img-mask group-hover:scale-110 transition-transform duration-700" alt="Ask AI">
                    <div class="p-6">
                        <h3 class="text-3xl font-black text-white" data-i18n="home.featAI">Ask Robot</h3>
                        <p class="text-blue-400 font-bold uppercase text-sm tracking-widest">AI Help</p>
                    </div>
                </div>

                <div onclick="window.location.href='/weather'" class="glass-panel group cursor-pointer overflow-hidden border-yellow-500/30">
                    <img src="https://plus.unsplash.com/premium_photo-1725408051956-a6dc142169bd?q=80&w=1297&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="w-full h-48 object-cover img-mask group-hover:scale-110 transition-transform duration-700" alt="Weather">
                    <div class="p-6">
                        <h3 class="text-3xl font-black text-white" data-i18n="home.featWeather">Rain & Sun</h3>
                        <p class="text-yellow-400 font-bold uppercase text-sm tracking-widest">Weather</p>
                    </div>
                </div>

                <div onclick="window.location.href='/community'" class="glass-panel group cursor-pointer overflow-hidden border-purple-500/30">
                    <img src="https://plus.unsplash.com/premium_photo-1681885032909-8d645ac23be4?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="w-full h-48 object-cover img-mask group-hover:scale-110 transition-transform duration-700" alt="Community">
                    <div class="p-6">
                        <h3 class="text-3xl font-black text-white" data-i18n="home.featCommunity">Community</h3>
                        <p class="text-purple-400 font-bold uppercase text-sm tracking-widest">Connect</p>
                    </div>
                </div>

                <div onclick="window.location.href='/animals'" class="glass-panel group cursor-pointer overflow-hidden border-orange-500/30">
                    <img src="https://images.unsplash.com/photo-1596733430284-f7437764b1a9?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="w-full h-48 object-cover img-mask group-hover:scale-110 transition-transform duration-700" alt="Livestock">
                    <div class="p-6">
                        <h3 class="text-3xl font-black text-white" data-i18n="home.featAnimals">Animals</h3>
                        <p class="text-orange-400 font-bold uppercase text-sm tracking-widest">Connecting for trade</p>
                    </div>
                </div>

                <div onclick="window.location.href='/crops'" class="glass-panel group cursor-pointer overflow-hidden border-yellow-200/30">
                    <img src="https://images.unsplash.com/photo-1643474004250-05d73e1473e0?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="w-full h-48 object-cover img-mask group-hover:scale-110 transition-transform duration-700" alt="Crops">
                    <div class="p-6">
                        <h3 class="text-3xl font-black text-white" data-i18n="home.featCrops">Sell Crops</h3>
                        <p class="text-yellow-200 font-bold uppercase text-sm tracking-widest">Market</p>
                    </div>
                </div>

                <div onclick="window.location.href='/teleVet'" class="glass-panel group cursor-pointer overflow-hidden border-red-500/30">
                    <img src="https://plus.unsplash.com/premium_photo-1681880789166-6085eaa4ed8b?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="w-full h-48 object-cover img-mask group-hover:scale-110 transition-transform duration-700" alt="Vet">
                    <div class="p-6">
                        <h3 class="text-3xl font-black text-white" data-i18n="home.featVet">Animal Doc</h3>
                        <p class="text-red-400 font-bold uppercase text-sm tracking-widest">Video Call</p>
                    </div>
                </div>

                <div onclick="window.location.href='/stock'" class="glass-panel group cursor-pointer overflow-hidden border-teal-500/30">
                    <img src="https://plus.unsplash.com/premium_photo-1742482666813-82d3db55f2bd?w=600" class="w-full h-48 object-cover img-mask group-hover:scale-110 transition-transform duration-700" alt="Seeds">
                    <div class="p-6">
                        <h3 class="text-3xl font-black text-white" data-i18n="home.featStock">Seeds/Tools</h3>
                        <p class="text-teal-400 font-bold uppercase text-sm tracking-widest">Inventory</p>
                    </div>
                </div>

            </div>
        </section>

        <section class="relative z-10 bg-black/40 backdrop-blur-lg py-24 border-t border-white/10">
            <div class="max-w-5xl mx-auto px-6">
                <div class="flex flex-col md:flex-row items-center gap-12">
                    <div class="md:w-1/3">
                        <h2 class="text-5xl font-black text-white mb-4 leading-tight" data-i18n="home.newToAarohi">New to <br><span class="text-green-400">Aarohi?</span></h2>
                        <p class="text-gray-400 text-lg font-medium" data-i18n="home.trainingDesc">Watch this quick video to learn how to grow your farming business today.</p>
                    </div>
                    <div class="md:w-2/3 w-full">
                        <div class="rounded-[2.5rem] overflow-hidden border-4 border-white/20 shadow-2xl aspect-video bg-black">
                            <video controls class="w-full h-full object-cover">
                                <source src="/videos/Aarohi.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include("../layouts/footer") %>

    <script>
        async function startVoiceCommand() {
            if (!('webkitSpeechRecognition' in window)) return;

            // speak a welcome / instruction phrase based on locale
            try {
                const lang = localStorage.getItem('aarohi_lang') || 'en';
                const res = await fetch(`/i18n/${lang}`);
                if (res.ok) {
                    const locale = await res.json();
                    if (locale.home && locale.home.voiceIntro) {
                        voiceSpeak(locale.home.voiceIntro);
                    }
                }
            } catch (_) {}

            const recognition = new webkitSpeechRecognition();
            const lang = localStorage.getItem('aarohi_lang') || 'en';
            const langMap = { en: 'en-IN', hi: 'hi-IN', kn: 'kn-IN' };
            recognition.lang = langMap[lang] || 'en-IN';
            recognition.start();
            recognition.onresult = (e) => {
                const t = e.results[0][0].transcript.toLowerCase();
                console.log('[voiceCommand] recognized:', t, 'lang', lang);

                const redirect = (url) => { window.location.href = url; };
                const storeAndGotoAI = (text) => {
                    localStorage.setItem('voiceQuery', text);
                    window.location.href = '/ai/assistant';
                };

                if (lang === 'hi') {
                    if (t.includes('योजना') || t.includes('scheme')) redirect('/schemes');
                    else if (t.includes('मौसम') || t.includes('weather')) redirect('/weather');
                    else if (t.includes('पशु') || t.includes('animal')) redirect('/animals');
                    else if (t.includes('डॉक्टर') || t.includes('doctor')) redirect('/teleVet');
                    else if (t.includes('होम') || t.includes('स्वागत')) redirect('/');
                    else storeAndGotoAI(t);
                } else if (lang === 'kn') {
                    if (t.includes('ಯೋಜನೆ') || t.includes('scheme')) redirect('/schemes');
                    else if (t.includes('ಹವಾಮಾನ') || t.includes('weather')) redirect('/weather');
                    else if (t.includes('ಪ್ರಾಣಿ') || t.includes('animal')) redirect('/animals');
                    else if (t.includes('ಡಾಕ್ಟರ್') || t.includes('doctor')) redirect('/teleVet');
                    else if (t.includes('ಮುಖಪುಟ') || t.includes('ಸ್ವಾಗತ')) redirect('/');
                    else storeAndGotoAI(t);
                } else {
                    if (t.includes('scheme')) redirect('/schemes');
                    else if (t.includes('weather')) redirect('/weather');
                    else if (t.includes('animal')) redirect('/animals');
                    else if (t.includes('doctor')) redirect('/teleVet');
                    else if (t.includes('home') || t.includes('welcome')) redirect('/');
                    else storeAndGotoAI(t);
                }
            };
        }
    </script>
</body>
</html>