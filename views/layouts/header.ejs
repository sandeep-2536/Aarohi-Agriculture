<header class="bg-[#0b2b1d]/95 backdrop-blur-md border-b-2 border-green-500/30 sticky top-0 z-50 shadow-[0_8px_30px_rgb(0,0,0,0.12)]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between h-20 md:h-24">
            
            <a href="/" class="flex items-center gap-4 transition-transform hover:scale-105">
                <div class="relative">
                    <div class="absolute inset-0 bg-green-400 blur-md opacity-20 rounded-full"></div>
                    <img src="/aarohi_logo.png" class="relative w-14 h-14 md:w-16 md:h-16 object-contain drop-shadow-lg" alt="Aarohi Logo" />
                </div>
                <div class="leading-tight">
                    <h1 class="text-white text-2xl md:text-3xl font-black tracking-tighter uppercase">Aarohi</h1>
                    <p class="text-[10px] md:text-xs font-bold text-green-400 tracking-[0.2em] uppercase">For Future of India</p>
                </div>
            </a>

            <div class="hidden lg:flex items-center gap-8">
                <nav class="flex items-center gap-8 mr-4">
                    <a href="/" class="text-gray-300 hover:text-white font-bold text-lg transition-colors" data-i18n="nav.home">Home</a>
                    <a href="/schemes" class="text-gray-300 hover:text-white font-bold text-lg transition-colors" data-i18n="nav.schemes">Schemes</a>
                    <a href="/community" class="text-gray-300 hover:text-white font-bold text-lg transition-colors" data-i18n="nav.community">Community</a>
                </nav>

                <div class="flex items-center bg-white/5 rounded-full p-1 border border-white/10 shadow-inner">
                    <button onclick="changeLanguage('en')" class="px-4 py-1.5 rounded-full text-xs font-black text-white hover:bg-green-600 transition-all">EN</button>
                    <button onclick="changeLanguage('hi')" class="px-4 py-1.5 rounded-full text-xs font-black text-white hover:bg-green-600 transition-all">हिंदी</button>
                    <button onclick="changeLanguage('kn')" class="px-4 py-1.5 rounded-full text-xs font-black text-white hover:bg-green-600 transition-all">ಕನ್ನಡ</button>
                </div>

                <div class="flex items-center gap-4 ml-4">
                    <a href="/ai/assistant" class="relative group">
                        <div class="absolute -inset-1 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-xl blur opacity-25 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"></div>
                        <button class="relative bg-yellow-500 text-black px-6 py-2.5 rounded-xl font-black text-lg shadow-xl flex items-center gap-2">
                            Ask AI <span class="text-xl">.</span>
                        </button>
                    </a>

                    <% if (user) { %>
                        <a href="/dashboard" class="flex items-center gap-3 bg-white/10 border border-white/20 px-4 py-2 rounded-2xl hover:bg-white/20 transition-all">
                            <div class="w-8 h-8 rounded-full bg-green-500 border-2 border-white/50 flex items-center justify-center font-bold text-white">
                                <%= user.name.charAt(0) %>
                            </div>
                            <span class="text-white font-bold text-sm"><%= user.name %></span>
                        </a>
                    <% } else { %>
                        <a href="/auth/login" class="text-white border-2 border-white/30 px-6 py-2 rounded-xl font-bold hover:bg-white hover:text-black transition-all" data-i18n="nav.login">Login</a>
                    <% } %>
                </div>
            </div>

            <button id="mobile-menu-btn" class="lg:hidden w-12 h-12 flex items-center justify-center bg-green-600/20 rounded-2xl border border-green-500/50 text-white">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8h16M4 16h16"></path>
                </svg>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden bg-[#0b2b1d] border-t border-green-900 px-6 py-8 space-y-6 animate-in slide-in-from-top duration-300">
        <div class="grid grid-cols-3 gap-3">
            <button onclick="changeLanguage('en')" class="bg-white/5 text-white py-3 rounded-xl text-sm font-bold border border-white/10">English</button>
            <button onclick="changeLanguage('hi')" class="bg-white/5 text-white py-3 rounded-xl text-sm font-bold border border-white/10">हिंदी</button>
            <button onclick="changeLanguage('kn')" class="bg-white/5 text-white py-3 rounded-xl text-sm font-bold border border-white/10">ಕನ್ನಡ</button>
        </div>
        
        <div class="flex flex-col gap-4 text-center">
            <a href="/" class="text-white text-2xl font-bold py-2">Home</a>
            <a href="/schemes" class="text-white text-2xl font-bold py-2">Government Schemes</a>
            <a href="/ai/assistant" class="bg-gradient-to-r from-yellow-400 to-yellow-600 text-black text-2xl font-black py-4 rounded-2xl shadow-lg">Ask AI Assistant </a>
            <a href="/community" class="text-white text-2xl font-bold py-2">Farmer Community</a>
            <hr class="border-white/10 my-2">
            <% if (!user) { %>
                <a href="/auth/login" class="text-green-400 text-xl font-bold py-2">Login to Account</a>
            <% } %>
        </div>
    </div>
</header>

<script>
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        // Simple animation trigger
        if(!mobileMenu.classList.contains('hidden')) {
            mobileMenu.classList.add('flex', 'flex-col');
        }
    });

    function changeLanguage(lang) {
        // persist selection so other scripts can read it
        localStorage.setItem('aarohi_lang', lang);
        // prefer the new helper; fallback to previous helpers or full reload
        if (window.setLanguage) {
            window.setLanguage(lang);
        } else if (typeof loadTranslations === 'function') {
            loadTranslations(lang);
        } else {
            window.location.reload(); 
        }
    }
</script>