<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="schemes.page_title">Farmer Schemes - Aarohi Agriculture</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Montserrat', 'sans-serif'] },
                    colors: {
                        'farm-deep': '#05190f',
                        'farm-green': '#1B4332',
                        'harvest-gold': '#FFB703'
                    },
                    animation: {
                        'grow-in': 'sprout 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards',
                    },
                    keyframes: {
                        sprout: {
                            '0%': { opacity: '0', transform: 'scale(0.9) translateY(30px)' },
                            '100%': { opacity: '1', transform: 'scale(1) translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Full Page Deep Green Canvas */
        body { 
            background-color: #05190f; 
            background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0);
            background-size: 40px 40px;
            color: white;
        }

        /* Glassmorphism for a futuristic feel */
        .glass-panel {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .scheme-card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-bottom: 6px solid rgba(74, 222, 128, 0.2);
        }

        .scheme-card:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: #4ade80;
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        /* Tactile Farmer Buttons */
        .btn-harvest {
            background: linear-gradient(to bottom, #FFB703, #fb8500);
            box-shadow: 0 4px 0 #8a4a00;
            transition: all 0.1s;
        }
        .btn-harvest:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #8a4a00;
        }

        .btn-leaf {
            background: linear-gradient(to bottom, #22c55e, #15803d);
            box-shadow: 0 4px 0 #064e3b;
        }
        .btn-leaf:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #064e3b;
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="antialiased min-h-screen">

    <%- include("../layouts/header") %>

    <section class="relative pt-24 pb-40 px-6 overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-gradient-to-b from-green-900/60 to-farm-deep"></div>
            <img src="/home_bg.jpg" class="w-full h-full object-cover opacity-20" alt="Farm Canvas">
        </div>

        <div class="max-w-7xl mx-auto text-center relative z-10">
            <div class="inline-flex items-center gap-4 glass-panel p-2 rounded-full border border-white/20 mb-10">
                <select id="langSelect" onchange="changeLanguage(this.value)" class="bg-white/10 text-white font-black rounded-full px-6 py-2 border-none focus:ring-2 focus:ring-green-400 cursor-pointer uppercase text-xs tracking-widest">
                    <option value="en">English</option>
                    <option value="hi">हिंदी</option>
                    <option value="kn">ಕನ್ನಡ</option>
                </select>
                
                <button onclick="toggleVoiceFeature()" id="voiceToggleBtn" class="flex items-center gap-2 px-6 py-2 rounded-full bg-green-500 text-farm-deep font-black text-xs uppercase tracking-widest hover:bg-green-400 transition-all shadow-lg">
                    <span>🔊 Voice Mode</span>
                </button>
            </div>

            <h1 class="text-6xl md:text-8xl font-black mb-6 tracking-tighter leading-none">
                Govt <span class="text-green-400 drop-shadow-[0_0_15px_rgba(74,222,128,0.3)]">Money</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-300 font-bold max-w-2xl mx-auto uppercase tracking-tighter">
                Simple Subsidies & Loans for your Harvest
            </p>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 -mt-24 relative z-20 pb-32">
        
        <div class="glass-panel p-6 rounded-[2.5rem] mb-16 shadow-2xl border-white/10">
            <div class="flex flex-col lg:flex-row gap-6 items-center">
                <div class="relative w-full lg:w-1/2">
                    <div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none">
                        <svg class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                    <input type="text" id="schemeSearch" onkeyup="filterSchemes(document.querySelector('.filter-btn.active').dataset.filter)"
                           class="block w-full pl-16 pr-6 py-5 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-green-400 focus:bg-white/10 transition-all text-xl font-bold" 
                           placeholder="Search (Tractor, Seeds, Loan)...">
                </div>

                <div class="flex overflow-x-auto w-full lg:w-1/2 gap-3 no-scrollbar">
                    <button onclick="filterSchemes('all')" class="filter-btn active whitespace-nowrap px-8 py-4 rounded-xl font-black bg-green-500 text-farm-deep tracking-widest text-xs uppercase" data-filter="all">All Schemes</button>
                    <button onclick="filterSchemes('All India')" class="filter-btn whitespace-nowrap px-8 py-4 rounded-xl font-black bg-white/5 text-white border border-white/10 tracking-widest text-xs uppercase hover:bg-white/10" data-filter="All India">Central Govt</button>
                    <button onclick="filterSchemes('Karnataka')" class="filter-btn whitespace-nowrap px-8 py-4 rounded-xl font-black bg-white/5 text-white border border-white/10 tracking-widest text-xs uppercase hover:bg-white/10" data-filter="Karnataka">State Govt</button>
                </div>
            </div>
        </div>

        <div id="schemesList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            <% schemes.forEach(scheme => { %>
            <div class="scheme-card rounded-[2.5rem] p-8 relative overflow-hidden group animate-grow-in"
                 data-state="<%= scheme.state %>" 
                 data-type="<%= scheme.type %>"
                 data-name="<%= scheme.name.toLowerCase() %>">
                
                <div class="relative z-10">
                    <div class="flex justify-between items-start mb-8">
                        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-green-400 to-green-600 flex items-center justify-center shadow-xl text-farm-deep transform -rotate-6 group-hover:rotate-0 transition-transform border-4 border-farm-deep">
                            <span class="text-4xl font-black"><%= scheme.name.charAt(0) %></span>
                        </div>
                        
                        <div class="text-right">
                             <span class="inline-block px-3 py-1 rounded-lg bg-green-400/20 text-green-400 text-[10px] font-black uppercase tracking-widest mb-1 border border-green-400/30">
                                <%= scheme.type %>
                             </span>
                             <p class="text-[10px] font-black text-gray-400 uppercase tracking-tighter">
                                <%= scheme.state === 'All India' ? 'Central Assistance' : scheme.state %>
                             </p>
                        </div>
                    </div>

                    <h3 class="text-3xl font-black text-white mb-4 leading-none tracking-tighter">
                        <%= scheme.name %>
                    </h3>
                    
                    <p class="text-gray-400 mb-10 font-medium leading-relaxed text-sm">
                        <%= scheme.desc %>
                    </p>

                    <div class="flex flex-col gap-3">
                        <button onclick="SchemeVoice.speakScheme('<%= scheme.name %>', '<%= scheme.desc %>')" 
                                class="btn-leaf py-4 rounded-2xl text-white font-black text-sm uppercase tracking-widest flex items-center justify-center gap-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
                            Listen Info
                        </button>
                        
                        <div class="grid grid-cols-2 gap-3">
                            <a href="https://pmkisan.gov.in/" target="_blank"
                               class="bg-white/5 border border-white/10 text-white py-4 rounded-2xl font-black text-xs uppercase text-center hover:bg-white/10 transition">
                                Details
                            </a>
                            <a href="https://pmkisan.gov.in/" target="_blank"
                               class="btn-harvest text-farm-deep py-4 rounded-2xl font-black text-xs uppercase text-center">
                                Apply Now
                            </a>
                        </div>
                    </div>
                </div>

                <div class="absolute -bottom-12 -right-12 text-white/5 transform rotate-45 pointer-events-none">
                    <svg class="w-48 h-48" fill="currentColor" viewBox="0 0 24 24"><path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8.13,20C11,20 13.8,18.5 15.65,15.86C17.5,13.24 18.25,10.25 17,8M13,17C11.5,17 10.15,16.36 9,15.35C8.45,14.86 8,14.28 7.6,13.65C7.2,13 7,12.3 7,11.5C7,10.3 7.5,9.25 8.25,8.5C9,7.75 10,7.25 11.25,7.25C12.5,7.25 13.5,7.75 14.25,8.5C15,9.25 15.5,10.3 15.5,11.5C15.5,12.7 15,13.75 14.25,14.5C13.5,15.25 12.5,15.75 11.25,15.75H11V17H13Z"/></svg>
                </div>
            </div>
            <% }) %>
        </div>

        <div id="noResults" class="hidden text-center py-40 glass-panel rounded-[3rem]">
            <div class="text-8xl mb-6 opacity-30">🌾</div>
            <h3 class="text-3xl font-black text-gray-500 uppercase tracking-tighter">No schemes found in this field.</h3>
            <button onclick="location.reload()" class="mt-6 text-green-400 font-black uppercase tracking-widest underline">Show all crops</button>
        </div>

    </section>

    <%- include("../layouts/footer") %>
    
    <script src="/js/voiceOver.js"></script>

    <script>
        // Keeping all your existing Voice and Filter logic exactly as is
        (function () {
            window.SchemeVoice = {
                speakScheme: function(name, desc) {
                    const text = `${name}. ${desc}`;
                    if (window.voiceSpeak) window.voiceSpeak(text);
                },
                readAllSchemes: function() {
                    const cards = document.querySelectorAll('.scheme-card:not([style*="display: none"])');
                    const btn = document.getElementById('voiceMainBtn');
                    if(btn) btn.classList.add('animate-pulse');

                    if (cards.length === 0) {
                        if (window.voiceSpeak) window.voiceSpeak("No visible schemes found.");
                        if(btn) btn.classList.remove('animate-pulse');
                        return;
                    }

                    let schemeList = `I found ${cards.length} schemes. `;
                    cards.forEach((card, index) => {
                        const name = card.querySelector('h3')?.textContent.trim() || '';
                        schemeList += `Scheme ${index + 1}: ${name}. `;
                    });
                    if (window.voiceSpeak) window.voiceSpeak(schemeList);
                    setTimeout(() => { if(btn) btn.classList.remove('animate-pulse'); }, 5000);
                },
                stopReading: function() {
                    if (window.voiceStop) window.voiceStop();
                }
            };

            document.addEventListener('DOMContentLoaded', function() {
                const dockHTML = `
                    <div id="schemeVoiceControls" class="fixed bottom-10 right-10 z-50 flex flex-col gap-4 items-end">
                        <button onclick="SchemeVoice.stopReading()" class="w-14 h-14 rounded-full bg-red-500 text-white shadow-2xl flex items-center justify-center hover:scale-110 transition-transform">
                            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM8 7a1 1 0 00-1 1v4a1 1 0 001 1h4a1 1 0 001-1V8a1 1 0 00-1-1H8z" clip-rule="evenodd"></path></svg>
                        </button>
                        <button id="voiceMainBtn" onclick="SchemeVoice.readAllSchemes()" 
                                class="btn-leaf px-8 py-5 rounded-2xl text-white font-black text-sm uppercase tracking-widest shadow-2xl flex items-center gap-4 hover:scale-105 transition-transform group">
                             <span>🔊 Read Entire Page</span>
                        </button>
                    </div>
                `;
                document.body.insertAdjacentHTML('beforeend', dockHTML);
            });
        })();

        let voiceEnabled = localStorage.getItem('aarohi_voice_enabled') !== 'false';

        function toggleVoiceFeature() {
            voiceEnabled = !voiceEnabled;
            localStorage.setItem('aarohi_voice_enabled', voiceEnabled);
            if (window.voiceToggle) window.voiceToggle(voiceEnabled);
            const btn = document.getElementById('voiceToggleBtn');
            btn.innerHTML = voiceEnabled ? '<span>🔊 Voice On</span>' : '<span>🔇 Voice Off</span>';
            const dock = document.getElementById('schemeVoiceControls');
            if(dock) dock.style.display = voiceEnabled ? 'flex' : 'none';
        }

        function filterSchemes(filter) {
            const searchInput = document.getElementById("schemeSearch").value.toLowerCase();
            const cards = document.querySelectorAll(".scheme-card");
            const noResults = document.getElementById("noResults");
            let count = 0;

            document.querySelectorAll(".filter-btn").forEach(btn => {
                btn.className = "filter-btn whitespace-nowrap px-8 py-4 rounded-xl font-black bg-white/5 text-white border border-white/10 tracking-widest text-xs uppercase hover:bg-white/10";
                if(btn.dataset.filter === filter) {
                    btn.className = "filter-btn active whitespace-nowrap px-8 py-4 rounded-xl font-black bg-green-500 text-farm-deep tracking-widest text-xs uppercase";
                }
            });

            cards.forEach(card => {
                const match = (filter === 'all' || card.dataset.state === filter) && 
                              (card.dataset.name.includes(searchInput));
                if (match) {
                    card.style.display = "block";
                    count++;
                } else {
                    card.style.display = "none";
                }
            });

            noResults.classList.toggle("hidden", count > 0);
            document.getElementById("schemesList").classList.toggle("hidden", count === 0);
        }

        function changeLanguage(lang) {
            localStorage.setItem('aarohi_lang', lang);
            window.location.href = window.location.pathname + '?lang=' + lang;
        }
    </script>
</body>
</html>