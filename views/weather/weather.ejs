<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather Forecast - AAROHI Agriculture</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background: #020d08;
            min-height: 100vh;
            color: white;
            overflow-x: hidden;
        }

        /* Ambient Background Canvas */
        .ambient-bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            background: 
                radial-gradient(circle at 10% 20%, rgba(16, 185, 129, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 90% 80%, rgba(5, 150, 105, 0.1) 0%, transparent 50%);
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .glass-panel:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: #4ade80;
            transform: translateY(-4px);
        }

        .weather-hero {
            background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(16, 185, 129, 0.05) 100%);
            border: 1px solid rgba(74, 222, 128, 0.2);
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 1.5rem;
        }

        .hourly-scroll::-webkit-scrollbar { height: 6px; }
        .hourly-scroll::-webkit-scrollbar-thumb { background: #4ade80; border-radius: 10px; }

        .btn-harvest {
            background: linear-gradient(to bottom, #FFB703, #fb8500);
            box-shadow: 0 4px 0 #8a4a00;
        }

        .btn-harvest:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #8a4a00;
        }
    </style>
</head>
<body class="antialiased">
    <div class="ambient-bg"></div>
    
    <%- include("../layouts/header") %>

    <main class="max-w-[95%] w-full mx-auto px-2 py-8 relative z-10">
        
        <% if (currentWeather) { %>
        <div class="weather-hero glass-panel rounded-[3rem] p-10 md:p-16 mb-10 overflow-hidden relative">
            <div class="flex flex-col xl:flex-row items-center justify-between gap-12 relative z-10">
                
                <div class="flex-1 text-center xl:text-left">
                    <div class="flex items-center justify-center xl:justify-start gap-4 mb-8">
                        <div class="bg-green-500 text-black px-6 py-2 rounded-full font-black text-sm uppercase tracking-widest shadow-[0_0_20px_rgba(74,222,128,0.4)]">
                            LIVE FORECAST
                        </div>
                        <h1 class="text-5xl md:text-7xl font-black tracking-tighter"><%= locationName %></h1>
                    </div>

                    <div class="flex flex-col md:flex-row items-center justify-center xl:justify-start gap-10">
                        <img src="http://openweathermap.org/img/wn/<%= currentWeather.icon %>@4x.png" 
                             class="w-48 h-48 drop-shadow-[0_0_30px_rgba(74,222,128,0.3)] animate-bounce-slow" alt="weather">
                        
                        <div class="text-center md:text-left">
                            <div class="text-8xl md:text-[10rem] font-black leading-none tracking-tighter text-white">
                                <%= currentWeather.temp %><span class="text-green-400">°</span>
                            </div>
                            <div class="text-3xl font-bold text-gray-400 capitalize mt-4"><%= currentWeather.description %></div>
                            <div class="mt-6 flex gap-4 justify-center md:justify-start">
                                <span class="bg-white/10 px-6 py-2 rounded-full text-lg font-bold border border-white/10">Feels like <%= currentWeather.feelsLike %>°C</span>
                                <span class="bg-green-500/10 text-green-400 px-6 py-2 rounded-full text-lg font-bold border border-green-500/20">Karnataka, IN</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-2 gap-4 w-full xl:w-[450px]">
                    <div class="stat-card p-8 flex flex-col items-center justify-center text-center hover:bg-white/5 transition-all">
                        <span class="text-4xl mb-2">💧</span>
                        <div class="text-4xl font-black"><%= currentWeather.humidity %>%</div>
                        <div class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-2">Humidity</div>
                    </div>
                    <div class="stat-card p-8 flex flex-col items-center justify-center text-center hover:bg-white/5 transition-all">
                        <span class="text-4xl mb-2">💨</span>
                        <div class="text-4xl font-black"><%= currentWeather.windSpeed %></div>
                        <div class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-2">km/h Wind</div>
                    </div>
                    <div class="stat-card p-8 flex flex-col items-center justify-center text-center hover:bg-white/5 transition-all">
                        <span class="text-4xl mb-2">🌅</span>
                        <div class="text-3xl font-black"><%= currentWeather.sunrise %></div>
                        <div class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-2">Sunrise</div>
                    </div>
                    <div class="stat-card p-8 flex flex-col items-center justify-center text-center hover:bg-white/5 transition-all">
                        <span class="text-4xl mb-2">🌇</span>
                        <div class="text-3xl font-black"><%= currentWeather.sunset %></div>
                        <div class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-2">Sunset</div>
                    </div>
                </div>
            </div>
            <div class="absolute -bottom-20 -left-20 w-96 h-96 bg-green-500/10 rounded-full blur-[100px]"></div>
        </div>
        <% } %>

        <% if (detailedForecast && detailedForecast.length > 0) { %>
        <div class="glass-panel rounded-[2.5rem] p-8 md:p-12 mb-10">
            <h2 class="text-3xl font-black mb-10 flex items-center gap-4">
                <span class="w-2 h-10 bg-green-500 rounded-full"></span>
                HOURLY HORIZON
            </h2>
            <div class="flex gap-6 overflow-x-auto hourly-scroll pb-8">
                <% detailedForecast.forEach(hour => { %>
                <div class="stat-card p-6 min-w-[180px] text-center border-white/5 hover:border-green-500/50">
                    <div class="text-xs font-black text-green-400 mb-4 tracking-widest"><%= hour.time %></div>
                    <img src="http://openweathermap.org/img/wn/<%= hour.icon %>@2x.png" class="w-24 h-24 mx-auto" alt="weather">
                    <div class="text-4xl font-black my-2"><%= hour.temp %>°</div>
                    <div class="text-[10px] font-bold text-gray-500 uppercase"><%= hour.desc %></div>
                    <% if (hour.pop > 0) { %>
                    <div class="mt-4 text-[10px] font-black bg-blue-500/20 text-blue-400 rounded-full px-4 py-1">🌧 <%= hour.pop %>%</div>
                    <% } %>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <div class="flex flex-col xl:flex-row gap-10">
            
            <div class="xl:w-[70%]">
                <div class="glass-panel rounded-[2.5rem] p-8 md:p-12 h-full">
                    <h2 class="text-3xl font-black mb-10 flex items-center gap-4">
                        <span class="w-2 h-10 bg-green-500 rounded-full"></span>
                        5-DAY FUTURE FIELD
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <% if (weatherData && weatherData.length > 0) { %>
                            <% weatherData.forEach(day => { %>
                            <div class="stat-card p-6 flex items-center justify-between border-white/10 hover:border-green-500/40">
                                <div class="flex items-center gap-6">
                                    <div class="text-xl font-black text-white"><%= day.date %></div>
                                    <img src="http://openweathermap.org/img/wn/<%= day.icon %>@2x.png" class="w-16 h-16" alt="weather">
                                    <div>
                                        <div class="font-black text-green-400 capitalize"><%= day.desc %></div>
                                        <div class="text-[10px] font-bold text-gray-500 tracking-widest mt-1 uppercase">Hum: <%= day.humidity %>%</div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-4xl font-black text-white"><%= day.temp %>°</div>
                                    <div class="text-[10px] font-bold text-gray-500 mt-1 uppercase tracking-tighter"><%= day.tempMin %>° / <%= day.tempMax %>°</div>
                                </div>
                            </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="xl:w-[30%] space-y-8">
                <div class="glass-panel rounded-[2.5rem] p-10 relative overflow-hidden border-yellow-500/20">
                    <div class="absolute -top-10 -right-10 w-32 h-32 bg-yellow-500/10 rounded-full blur-3xl"></div>
                    <h2 class="text-2xl font-black text-yellow-500 mb-8 flex items-center gap-3">
                        <span>🤖</span> AI FARM ADVISOR
                    </h2>
                    <div class="text-sm leading-relaxed text-gray-300 font-medium space-y-4">
                        <%- aiAdvice %>
                    </div>
                </div>

                <div class="glass-panel rounded-[2.5rem] p-10">
                    <h3 class="text-xl font-black text-white mb-8 uppercase tracking-widest">Fast Actions</h3>
                    <div class="grid grid-cols-1 gap-4">
                        <a href="/dashboard" class="bg-white/5 hover:bg-white/10 p-6 rounded-2xl flex items-center justify-between border border-white/10 group transition-all">
                            <span class="font-black text-sm uppercase tracking-widest group-hover:text-green-400">View My Crops</span>
                            <span class="text-2xl">🚜</span>
                        </a>
                        <a href="/ai/assistant" class="btn-harvest p-6 rounded-2xl flex items-center justify-between group transition-all shadow-xl">
                            <span class="font-black text-sm uppercase tracking-widest text-farm-deep">Ask AI Helper</span>
                            <span class="text-2xl">✨</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="h-20"></div> <%- include("../layouts/footer") %>

    <script>
        // Automatic Location Fetching
        (function() {
            const params = new URLSearchParams(window.location.search);
            if (params.has('lat') || params.has('lon')) return;

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    const url = new URL(window.location.href);
                    url.searchParams.set('lat', position.coords.latitude);
                    url.searchParams.set('lon', position.coords.longitude);
                    window.location.replace(url.toString());
                }, null, { enableHighAccuracy: true, timeout: 8000 });
            }
        })();
    </script>
</body>
</html>